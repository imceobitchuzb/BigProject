---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import AuthCabinetModal from '../components/AuthCabinetModal.astro';
import SearchModal from '../components/SearchModal.astro';
import AiAssistantWidget from '../components/AiAssistantWidget.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentLang: 'en' | 'ru';
  canonicalSlug?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description,
  currentLang,
  canonicalSlug = '',
  ogType = 'website',
  publishedTime,
} = Astro.props;

const isRu = currentLang === 'ru';

const canonicalUrl = new URL(`/${currentLang}/${canonicalSlug}`, Astro.site || 'https://safeingame.org').href;
const enAltUrl    = new URL(`/en/${canonicalSlug}`, Astro.site || 'https://safeingame.org').href;
const ruAltUrl    = new URL(`/ru/${canonicalSlug}`, Astro.site || 'https://safeingame.org').href;
const ogImage     = new URL('/images/logo.png', Astro.site || 'https://safeingame.org').href;

const pathname = Astro.url.pathname;

const navItems = [
  { href: `/${currentLang}/`,             label: isRu ? 'Обзор' : 'Overview',               icon: 'home',    section: 'main' },
  { href: `/${currentLang}/scanner/`,     label: isRu ? 'Сканер ссылок' : 'Link Scanner',    icon: 'scanner', section: 'main' },
  { href: `/${currentLang}/detective/`,   label: isRu ? 'ИИ-детектив' : 'AI Detective',      icon: 'ai',      section: 'main', badge: 'AI' },
  { href: `/${currentLang}/simulator/`,   label: isRu ? 'Симулятор скама' : 'Scam Simulator',icon: 'sim',     section: 'main' },
  { href: `/${currentLang}/radar/`,       label: isRu ? 'Радар угроз' : 'Threat Radar',      icon: 'radar',   section: 'main' },
  { href: `/${currentLang}/games/`,       label: isRu ? 'Игровые центры' : 'Game Centers',  icon: 'game',    section: 'learn' },
  { href: `/${currentLang}/academy/`,     label: isRu ? 'Академия' : 'Academy',             icon: 'academy', section: 'learn' },
  { href: `/${currentLang}/threats/`,     label: isRu ? 'База угроз' : 'Threat Library',    icon: 'threats', section: 'learn' },
  { href: `/${currentLang}/parents/`,     label: isRu ? 'Родителям' : 'Parent Mode',        icon: 'family',  section: 'family', badge: isRu ? 'ДЕТЯМ' : 'FAMILY' },
  { href: `/${currentLang}/recovery/`,    label: isRu ? 'Спасение аккаунта' : 'Account Rescue', icon: 'rescue', section: 'family', badge: 'SOS', isSos: true },
  { href: `/${currentLang}/score/`,       label: isRu ? 'Рейтинг защиты' : 'Security Score',icon: 'score',   section: 'community' },
  { href: `/${currentLang}/report/`,      label: isRu ? 'Сообщить об угрозе' : 'Community Report', icon: 'report', section: 'community' },
  { href: `/${currentLang}/about/`,       label: isRu ? 'О проекте' : 'About',             icon: 'about',   section: 'meta' },
  { href: `/${currentLang}/contact/`,     label: isRu ? 'Контакты' : 'Contact',             icon: 'contact', section: 'meta' },
];

const sectionLabels = {
  main: isRu ? 'Главное' : 'Main',
  learn: isRu ? 'База знаний' : 'Learn',
  family: isRu ? 'Безопасность' : 'Safety',
  community: isRu ? 'Сообщество' : 'Community',
};

const uiText = {
  subtitle: isRu ? 'Игровая кибербезопасность' : 'Gaming Cybersecurity',
  cyberDefender: isRu ? 'Кибер-защитник' : 'Cyber Defender',
  defenseHygiene: isRu ? 'Уровень защиты' : 'Defense Hygiene',
  scanUrl: isRu ? 'Проверить' : 'Scan URL',
  searchPlaceholder: isRu ? 'Поиск по функциям, играм, угрозам...' : 'Search features, games, threats...',
  protected: isRu ? 'Защищено' : 'Protected',
  expandSidebar: isRu ? 'Развернуть меню' : 'Expand sidebar',
  collapseSidebar: isRu ? 'Свернуть меню' : 'Collapse sidebar',
  openCabinet: isRu ? 'Личный кабинет игрока' : 'Gamer Security Profile',
  shieldLv: isRu ? 'Щит Ур. 12' : 'Shield Lv.12',
};

function isActive(href: string): boolean {
  if (href === `/${currentLang}/`) return pathname === href || pathname === `/${currentLang}`;
  return pathname.startsWith(href);
}
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Theme Initialization Script (Prevents FOUC) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('safeingame_theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored ? stored : (prefersDark ? 'dark' : 'light');
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          }
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/logo.png" />

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="en" href={enAltUrl} />
    <link rel="alternate" hreflang="ru" href={ruAltUrl} />
    <link rel="alternate" hreflang="x-default" href={enAltUrl} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={currentLang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:site_name" content="SafeInGame" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@SafeInGame" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'EducationalOrganization',
      name: 'SafeInGame',
      url: 'https://safeingame.org',
      logo: ogImage,
      description: 'Independent gaming safety education platform helping players recognize scams and protect virtual assets.',
      sameAs: [
        'https://x.com/SafeInGame',
        'https://t.me/SafeInGame',
        'https://instagram.com/SafeInGame',
        'https://tiktok.com/@SafeInGame'
      ]
    })} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[var(--bg-page)] text-[var(--text-main)] selection:bg-ds-accent/30 selection:text-ds-text transition-colors duration-300">

    <!-- ═══════════════════════════════════ DASHBOARD SHELL ═══════════════════════════════════ -->
    <div class="dashboard-shell">

      <!-- Mobile Overlay -->
      <div id="sidebar-overlay" class="sidebar-overlay" aria-hidden="true"></div>

      <!-- Mobile Floating Pull-Tab Button (Swipe or Tap indicator) -->
      <button
        id="mobile-floating-open-btn"
        class="lg:hidden fixed left-0 top-1/2 -translate-y-1/2 z-40 w-6 h-14 rounded-r-xl bg-ds-accent/90 hover:bg-ds-accent text-white flex items-center justify-center shadow-lg shadow-ds-accent/30 transition-transform active:scale-95 cursor-pointer"
        aria-label="Open sidebar menu"
        title={uiText.expandSidebar}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      <!-- ════════════════════ LEFT SIDEBAR ════════════════════ -->
      <aside id="dashboard-sidebar" class="dashboard-sidebar" aria-label="Main navigation">

        <!-- Sidebar Header / Logo -->
        <div class="flex items-center gap-3 px-5 py-4 border-b border-white/5 flex-shrink-0">
          <a href={`/${currentLang}/`} class="flex items-center gap-3 group min-w-0">
            <div class="relative w-9 h-9 flex-shrink-0">
              <div class="absolute inset-0 rounded-xl bg-gradient-to-br from-ds-accent to-ds-cyber opacity-20 group-hover:opacity-40 transition-opacity"></div>
              <img
                src="/images/logo.png"
                alt="SafeInGame"
                class="w-full h-full object-contain rounded-xl relative z-10 filter drop-shadow-[0_0_8px_rgba(72,214,232,0.4)]"
                width="36"
                height="36"
              />
            </div>
            <div class="sidebar-label-group flex-col min-w-0 overflow-hidden">
              <span class="font-heading font-extrabold text-base tracking-tight text-ds-text whitespace-nowrap">
                Safe<span class="text-ds-cyber">In</span>Game
              </span>
              <span class="text-[10px] text-ds-text2 font-medium tracking-wide whitespace-nowrap">{uiText.subtitle}</span>
            </div>
          </a>

          <!-- Desktop collapse toggle -->
          <button
            id="sidebar-collapse-btn"
            class="hidden lg:flex ml-auto flex-shrink-0 w-7 h-7 items-center justify-center rounded-lg text-ds-text2 hover:text-ds-text hover:bg-white/5 transition-all cursor-pointer"
            aria-label="Toggle sidebar"
            title={uiText.collapseSidebar}
          >
            <svg id="collapse-icon" class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
            </svg>
          </button>
        </div>

        <!-- Desktop Expand Button on Collapsed Rail -->
        <button
          id="sidebar-expand-rail-btn"
          class="hidden w-10 h-10 mx-auto my-2 rounded-xl bg-ds-accent/15 border border-ds-accent/30 text-ds-accent hover:bg-ds-accent/25 hover:text-white items-center justify-center transition-all cursor-pointer flex-shrink-0"
          aria-label="Expand sidebar"
          title={uiText.expandSidebar}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
          </svg>
        </button>

        <!-- Sidebar Navigation -->
        <nav class="flex-1 overflow-y-auto overflow-x-hidden py-3 space-y-0.5" aria-label="Sidebar navigation">

          <!-- User Defense Mini-Card (Click opens Auth Cabinet) -->
          <div
            id="sidebar-profile-card"
            class="sidebar-label-group px-4 py-3 mx-2 mb-2 rounded-2xl bg-white/5 border border-white/10 hover:border-ds-cyber/40 hover:bg-white/10 transition-all flex-shrink-0 cursor-pointer group"
            data-open-auth-cabinet="true"
            role="button"
            tabindex="0"
            title={uiText.openCabinet}
          >
            <div class="flex items-center gap-2.5 mb-2.5">
              <div class="relative w-8 h-8 rounded-xl bg-ds-surface3 border border-ds-cyber/40 flex items-center justify-center flex-shrink-0 text-xs font-bold text-ds-cyber" id="sidebar-user-avatar">
                🛡️
                <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-400 border border-ds-bg"></span>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-ds-text truncate group-hover:text-ds-cyber transition-colors" id="sidebar-user-tag">Guardian_01</span>
                  <span class="text-[9px] text-ds-cyber font-bold">LVL 12</span>
                </div>
                <div class="text-[10px] text-ds-text2">{uiText.cyberDefender}</div>
              </div>
            </div>

            <!-- Progress bar -->
            <div class="mb-2">
              <div class="flex justify-between text-[9px] text-ds-text2 mb-1">
                <span>{uiText.defenseHygiene}</span>
                <span class="text-emerald-400 font-bold">88%</span>
              </div>
              <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                <div class="h-full rounded-full bg-gradient-to-r from-ds-accent to-ds-cyber" style="width: 88%;"></div>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="flex gap-1.5 pt-1">
              <button
                type="button"
                class="flex-1 py-1 rounded-lg bg-ds-cyber/15 hover:bg-ds-cyber/25 border border-ds-cyber/30 text-ds-cyber font-bold text-[10px] text-center transition-all cursor-pointer"
              >
                {uiText.scanUrl}
              </button>
              <div
                class="p-1 rounded-lg bg-white/5 hover:bg-white/10 text-ds-text2 hover:text-ds-text transition-all"
                title={uiText.openCabinet}
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- MAIN section -->
          <div class="sidebar-section-label sidebar-label-group">{sectionLabels.main}</div>
          {navItems.filter(i => i.section === 'main').map(item => (
            <a
              href={item.href}
              class={`sidebar-item ${isActive(item.href) ? 'active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="item-icon flex-shrink-0">
                {item.icon === 'home' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                  </svg>
                )}
                {item.icon === 'scanner' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                )}
                {item.icon === 'ai' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                  </svg>
                )}
                {item.icon === 'sim' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                )}
                {item.icon === 'radar' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728M9 12a3 3 0 106 0 3 3 0 00-6 0M12 8v4"/>
                  </svg>
                )}
              </span>
              <span class="item-label sidebar-label-group">{item.label}</span>
              {item.badge && !item.isSos && (
                <span class="sidebar-label-group ml-auto text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-ds-accent/20 text-ds-accent border border-ds-accent/30 uppercase tracking-wide">{item.badge}</span>
              )}
              {item.isSos && (
                <span class="sidebar-label-group ml-auto text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-red-500/20 text-red-400 border border-red-500/30 uppercase tracking-wide animate-pulse">{item.badge}</span>
              )}
            </a>
          ))}

          <!-- LEARN section -->
          <div class="sidebar-section-label sidebar-label-group mt-2">{sectionLabels.learn}</div>
          {navItems.filter(i => i.section === 'learn').map(item => (
            <a
              href={item.href}
              class={`sidebar-item ${isActive(item.href) ? 'active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="item-icon flex-shrink-0">
                {item.icon === 'game' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/>
                  </svg>
                )}
                {item.icon === 'academy' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                  </svg>
                )}
                {item.icon === 'threats' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                )}
              </span>
              <span class="item-label sidebar-label-group">{item.label}</span>
            </a>
          ))}

          <!-- SAFETY section -->
          <div class="sidebar-section-label sidebar-label-group mt-2">{sectionLabels.family}</div>
          {navItems.filter(i => i.section === 'family').map(item => (
            <a
              href={item.href}
              class={`sidebar-item ${isActive(item.href) ? 'active' : ''} ${item.isSos ? 'border border-red-500/20 hover:border-red-500/40' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class={`item-icon flex-shrink-0 ${item.isSos ? 'text-red-400' : ''}`}>
                {item.icon === 'family' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                )}
                {item.icon === 'rescue' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                )}
              </span>
              <span class={`item-label sidebar-label-group ${item.isSos ? 'text-red-400 font-bold' : ''}`}>{item.label}</span>
              {item.isSos && (
                <span class="sidebar-label-group ml-auto text-[9px] font-bold px-1.5 py-0.5 rounded-md bg-red-500/20 text-red-400 border border-red-500/30 uppercase tracking-wide animate-pulse">SOS</span>
              )}
            </a>
          ))}

          <!-- COMMUNITY section -->
          <div class="sidebar-section-label sidebar-label-group mt-2">{sectionLabels.community}</div>
          {navItems.filter(i => i.section === 'community').map(item => (
            <a
              href={item.href}
              class={`sidebar-item ${isActive(item.href) ? 'active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="item-icon flex-shrink-0">
                {item.icon === 'score' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                  </svg>
                )}
                {item.icon === 'report' && (
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/>
                  </svg>
                )}
              </span>
              <span class="item-label sidebar-label-group">{item.label}</span>
            </a>
          ))}
