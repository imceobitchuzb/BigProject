          <!-- Language selector (desktop top bar) -->
          <div class="hidden lg:flex items-center gap-0.5 bg-white/5 border border-white/10 rounded-xl p-0.5">
            <a href={`/en${pathname.replace(/^\/(en|ru)/, '')}`} class={`text-xs px-2.5 py-1 rounded-lg font-semibold transition-all ${currentLang === 'en' ? 'bg-ds-accent/20 text-ds-accent' : 'text-ds-text2 hover:text-ds-text'}`}>EN</a>
            <a href={`/ru${pathname.replace(/^\/(en|ru)/, '')}`} class={`text-xs px-2.5 py-1 rounded-lg font-semibold transition-all ${currentLang === 'ru' ? 'bg-ds-accent/20 text-ds-accent' : 'text-ds-text2 hover:text-ds-text'}`}>RU</a>
          </div>

          <!-- User Profile Button (Opens Auth & Cabinet Modal) -->
          <button
            type="button"
            id="topbar-profile-btn"
            class="flex items-center gap-2 pl-2 pr-2.5 sm:pr-3 py-1 rounded-xl bg-white/5 border border-white/10 hover:border-ds-cyber/40 transition-all group cursor-pointer"
            title={uiText.openCabinet}
            data-open-auth-cabinet="true"
          >
            <div class="relative w-7 h-7 rounded-lg overflow-hidden border border-ds-cyber/40 flex-shrink-0 bg-ds-surface3 flex items-center justify-center text-xs" id="topbar-user-avatar">
              🛡️
              <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-emerald-400 border border-ds-bg"></span>
            </div>
            <div class="hidden sm:flex flex-col text-left">
              <span class="text-xs font-bold text-ds-text leading-tight group-hover:text-ds-cyber transition-colors" id="topbar-user-tag">Guardian_01</span>
              <span class="text-[9px] text-emerald-400 font-semibold leading-tight">{uiText.shieldLv}</span>
