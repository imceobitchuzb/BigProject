        </div>
      </header>

      <!-- ════════════════════ MAIN CONTENT ════════════════════ -->
      <main id="dashboard-main" class="dashboard-main min-h-screen">
        <slot />
      </main>

    </div>

    <!-- Footer — full width after main -->
    <footer class="ml-0 lg:ml-[var(--sidebar-width)] border-t border-ds-border bg-ds-surface transition-all duration-300" id="dashboard-footer">
      <div class="max-w-7xl mx-auto px-6 py-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <span class="font-heading font-bold text-sm text-ds-text">Safe<span class="text-ds-cyber">In</span>Game</span>
            <span class="text-ds-text2 text-xs">{isRu ? '— Независимая платформа игровой кибербезопасности.' : '— Independent gaming cybersecurity platform.'}</span>
          </div>
          <div class="flex items-center gap-4 text-xs text-ds-text2">
            <a href={`/${currentLang}/privacy/`} class="hover:text-ds-text transition-colors">{isRu ? 'Конфиденциальность' : 'Privacy'}</a>
            <a href={`/${currentLang}/terms/`} class="hover:text-ds-text transition-colors">{isRu ? 'Условия' : 'Terms'}</a>
            <a href={`/${currentLang}/contact/`} class="hover:text-ds-text transition-colors">{isRu ? 'Контакты' : 'Contact'}</a>
            <a href="https://t.me/SafeInGame" target="_blank" rel="noopener" class="hover:text-ds-cyber transition-colors">Telegram</a>
          </div>
