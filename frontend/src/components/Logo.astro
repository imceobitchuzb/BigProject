---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  currentLang?: 'en' | 'ru';
}

const { size = 'md', showText = true, currentLang = 'en' } = Astro.props;

const dimensions = {
  sm: 'w-8 h-8',
  md: 'w-10 h-10',
  lg: 'w-14 h-14',
}[size];

const textSize = {
  sm: 'text-lg',
  md: 'text-xl',
  lg: 'text-2xl sm:text-3xl',
}[size];

const tagline = currentLang === 'ru' ? 'Играй с умом. Оставайся в безопасности.' : 'Play smart. Stay safe.';
---

<div class="flex items-center gap-3 select-none">
  <!-- Mascot Logo Photo -->
  <div class={`relative ${dimensions} flex-shrink-0 transition-transform duration-200 hover:scale-105`}>
    <img
      src="/images/logo.png"
      alt="SafeInGame Mascot"
      class="w-full h-full object-contain filter drop-shadow-[0_0_8px_rgba(34,211,238,0.35)] rounded-lg"
      width="48"
      height="48"
    />
  </div>

  <!-- Wordmark -->
  {showText && (
    <div class="flex flex-col">
      <span class={`font-heading font-extrabold ${textSize} tracking-tight text-slate-900 dark:text-cloud flex items-center leading-none`}>
        Safe<span class="text-cyan-dark dark:text-cyan mx-0.5">In</span>Game
      </span>
      <span class="text-[10px] uppercase tracking-widest text-slate-500 dark:text-cloud-muted font-medium mt-1 hidden sm:inline-block">
        {tagline}
      </span>
    </div>
  )}
</div>
