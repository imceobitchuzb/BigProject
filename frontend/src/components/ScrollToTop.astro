---
interface Props {
  currentLang?: 'en' | 'ru';
}

const { currentLang = 'en' } = Astro.props;
const label = currentLang === 'ru' ? 'Вернуться наверх' : 'Scroll to top';
---

<!-- Floating Scroll-To-Top Button -->
<button
  id="scroll-to-top-btn"
  type="button"
  aria-label={label}
  title={label}
  class="fixed bottom-6 right-6 z-50 p-3 sm:p-3.5 rounded-2xl bg-white/95 dark:bg-navy-850/95 text-slate-800 dark:text-cyan border border-slate-300/80 dark:border-cyan/40 shadow-xl shadow-slate-900/10 dark:shadow-[0_0_20px_rgba(34,211,238,0.25)] backdrop-blur-md transition-all duration-300 ease-out opacity-0 pointer-events-none translate-y-4 scale-90 hover:scale-110 active:scale-95 hover:border-cyan-dark hover:text-cyan-dark dark:hover:border-cyan dark:hover:text-cyan-light focus:outline-none focus:ring-2 focus:ring-cyan group"
>
  <svg
    class="w-5 h-5 transition-transform duration-200 group-hover:-translate-y-1"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path d="M5 15l7-7 7 7" />
  </svg>
</button>

<script>
  function initScrollToTop() {
    const btn = document.getElementById('scroll-to-top-btn');
    if (!btn) return;

    let ticking = false;

    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollDistance = window.scrollY || document.documentElement.scrollTop;
          if (scrollDistance > 280) {
            btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4', 'scale-90');
            btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
          } else {
            btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
            btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4', 'scale-90');
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    btn.onclick = () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    };
  }

  initScrollToTop();
  document.addEventListener('astro:page-load', initScrollToTop);
</script>
