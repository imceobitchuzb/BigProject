---
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  currentLang: 'en' | 'ru';
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
---

<footer class="border-t border-slate-200 dark:border-navy-800 bg-white dark:bg-navy-950 pt-12 pb-8 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Brand & Tagline -->
      <div class="md:col-span-1 space-y-4">
        <Logo size="md" currentLang={currentLang} />
        <p class="text-sm text-slate-600 dark:text-cloud-muted leading-relaxed">
          {t('site.tagline')}
        </p>
        <p class="text-xs text-slate-500 dark:text-cloud-subtle leading-relaxed">
          {currentLang === 'en'
            ? 'Independent educational center for online gaming account safety and asset protection.'
            : 'Независимый образовательный центр по защите игровых аккаунтов и виртуальных ценностей.'}
        </p>
      </div>

      <!-- Col 2: Educational Hub -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-cyan-dark dark:text-cyan">
          {currentLang === 'en' ? 'Game Hub & Guides' : 'Игровой хаб и гиды'}
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`/${currentLang}/recovery/`} class="text-red-600 dark:text-red-400 font-semibold hover:underline transition-colors flex items-center gap-1.5">
              <span>{t('nav.recovery')}</span>
              <span class="text-[9px] px-1 py-0.2 rounded bg-red-500/15 text-red-600 dark:text-red-400 font-bold uppercase">SOS</span>
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/scanner/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              {t('nav.scanner')}
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/lab/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              {t('nav.lab')}
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/games/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              {t('nav.games')}
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/safety/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              {t('nav.safety')}
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/threats/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              {t('nav.threats')}
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/games/cs2-steam/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              CS2 / Steam
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/games/brawl-stars/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              Brawl Stars
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: About & Transparency -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-cyan-dark dark:text-cyan">
          {currentLang === 'en' ? 'Platform' : 'Платформа'}
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`/${currentLang}/about/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              {t('nav.about')}
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/contact/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              {t('nav.contact')}
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/privacy/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              {t('footer.privacy')}
            </a>
          </li>
          <li>
            <a href={`/${currentLang}/terms/`} class="text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan transition-colors">
              {t('footer.terms')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Community & Social -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-cyan-dark dark:text-cyan">
          {t('social.follow')}
        </h3>
        <p class="text-xs text-slate-500 dark:text-cloud-subtle">
          {currentLang === 'en'
            ? 'Follow our official channels for gaming threat advisories:'
            : 'Подписывайтесь на официальные каналы проекта:'}
        </p>
        <SocialLinks variant="card" />
      </div>
    </div>

    <!-- Legal & Disclaimer -->
    <div class="border-t border-slate-200 dark:border-navy-850 pt-8 mt-8 space-y-4">
      <p class="text-xs text-slate-500 dark:text-cloud-subtle leading-relaxed">
        {t('footer.disclaimer')}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 dark:text-cloud-subtle gap-2">
        <span>© 2026 SafeInGame. {t('footer.rights')}</span>
        <div class="flex items-center gap-4">
          <a href={`/${currentLang}/privacy/`} class="hover:text-slate-700 dark:hover:text-cloud-muted transition-colors">
            {t('footer.privacy')}
          </a>
          <span>•</span>
          <a href={`/${currentLang}/terms/`} class="hover:text-slate-700 dark:hover:text-cloud-muted transition-colors">
            {t('footer.terms')}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
