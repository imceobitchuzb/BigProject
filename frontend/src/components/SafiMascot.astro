---
interface Props {
  mood?: 'guard' | 'alert' | 'celebrate' | 'thinking' | 'sleeping';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { mood = 'guard', size = 'md', class: className = '' } = Astro.props;

const sizeMap = {
  sm: 'w-10 h-10',
  md: 'w-16 h-16',
  lg: 'w-24 h-24',
  xl: 'w-36 h-36',
};

const eyeColor = mood === 'alert' ? '#ef4444' : mood === 'celebrate' ? '#10b981' : '#00e5ff';
---

<div class={`relative inline-flex items-center justify-center ${sizeMap[size]} ${className}`} aria-label={`SAFI Mascot (${mood})`}>
  <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-lg transition-transform hover:scale-105 duration-300">
    <!-- Cyber Owl / Drone Outer Helmet / Shield Body -->
    <path
      d="M60 10 C32 10 18 28 18 55 C18 85 45 106 60 112 C75 106 102 85 102 55 C102 28 88 10 60 10 Z"
      fill="url(#safi-body-grad)"
      stroke="#00e5ff"
      stroke-width="3"
    />

    <!-- Cyber Shield Wings / Ear Panels -->
    <path d="M18 42 L8 56 L20 72 Z" fill="#00e5ff" opacity="0.8" />
    <path d="M102 42 L112 56 L100 72 Z" fill="#00e5ff" opacity="0.8" />

    <!-- Helmet Visor / Face Screen -->
    <rect x="28" y="38" width="64" height="42" rx="14" fill="#070c18" stroke="#1e293b" stroke-width="2" />

    <!-- Visor Scanline Accent -->
    <line x1="30" y1="58" x2="90" y2="58" stroke={eyeColor} stroke-width="1" opacity="0.3" stroke-dasharray="2 3" />

    {mood === 'alert' && (
      <!-- Alert Eyes (Warning Angles) -->
      <g>
        <path d="M38 52 L52 58" stroke="#ef4444" stroke-width="5" stroke-linecap="round" />
        <path d="M82 52 L68 58" stroke="#ef4444" stroke-width="5" stroke-linecap="round" />
        <circle cx="45" cy="62" r="5" fill="#ef4444" />
        <circle cx="75" cy="62" r="5" fill="#ef4444" />
      </g>
    )}

    {mood === 'guard' && (
      <!-- Focused Guardian Eyes -->
      <g>
        <circle cx="45" cy="58" r="7" fill={eyeColor} />
        <circle cx="75" cy="58" r="7" fill={eyeColor} />
        <circle cx="47" cy="56" r="2.5" fill="#ffffff" />
        <circle cx="77" cy="56" r="2.5" fill="#ffffff" />
        <!-- Digital Beak / Shield Crest -->
        <polygon points="60,65 54,72 66,72" fill="#00e5ff" />
      </g>
    )}

    {mood === 'celebrate' && (
      <!-- Happy Arc Eyes -->
      <g>
        <path d="M38 60 Q45 50 52 60" stroke="#10b981" stroke-width="4" stroke-linecap="round" fill="none" />
        <path d="M68 60 Q75 50 82 60" stroke="#10b981" stroke-width="4" stroke-linecap="round" fill="none" />
        <polygon points="60,64 55,70 65,70" fill="#10b981" />
      </g>
    )}

    {mood === 'thinking' && (
      <!-- Curious Analyzer Eyes -->
      <g>
        <circle cx="45" cy="56" r="6" fill="#38bdf8" />
        <circle cx="75" cy="58" r="4" fill="#38bdf8" />
        <circle cx="46" cy="54" r="2" fill="#ffffff" />
        <path d="M56 70 Q60 67 64 70" stroke="#38bdf8" stroke-width="2" stroke-linecap="round" />
      </g>
    )}

    {mood === 'sleeping' && (
      <!-- Sleeping Lines -->
      <g>
        <line x1="38" y1="58" x2="52" y2="58" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
        <line x1="68" y1="58" x2="82" y2="58" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
      </g>
    )}

    <!-- Chest Armor Shield Insignia -->
    <path d="M54 88 L60 84 L66 88 L60 97 Z" fill="#00e5ff" opacity="0.9" />

    <!-- Gradients -->
    <defs>
      <linearGradient id="safi-body-grad" x1="60" y1="10" x2="60" y2="112" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#1e293b" />
        <stop offset="60%" stop-color="#0f172a" />
        <stop offset="100%" stop-color="#020617" />
      </linearGradient>
    </defs>
  </svg>
</div>
