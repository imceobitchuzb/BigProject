---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameArtwork from './GameArtwork.astro';
import ThreatCard from './ThreatCard.astro';
import type { GameSecurityProfile } from '../data/games';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/ui';

interface Props {
  game: GameSecurityProfile;
  currentLang: 'en' | 'ru';
}

const { game, currentLang } = Astro.props;
const t = useTranslations(currentLang);

// Get related articles
const allThreats = await getCollection('threats', ({ id }) => id.startsWith(`${currentLang}/`));
const relatedArticles = allThreats
  .filter((item) => {
    const rawSlug = item.id.replace(`${currentLang}/`, '').replace(/\.md$/, '');
    return game.relatedArticleSlugs.includes(rawSlug);
  })
  .map((item) => ({
    slug: item.id.replace(`${currentLang}/`, '').replace(/\.md$/, ''),
    data: item.data,
  }));
---

<BaseLayout
  title={`${game.title} Security Hub — SafeInGame`}
  description={game.subtitle}
  currentLang={currentLang}
  canonicalSlug={`games/${game.slug}/`}
>
  <!-- Hero Section with Custom Game Background -->
  <section class="relative overflow-hidden pt-12 pb-16 lg:pt-16 lg:pb-24 border-b border-slate-200 dark:border-navy-800">
    <div
      class="absolute inset-0 bg-gradient-to-b opacity-40 pointer-events-none"
      style={`background-image: linear-gradient(to bottom, ${game.colorTheme.heroGradient});`}
    ></div>
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.06] cyber-grid-pattern pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-cloud-subtle mb-6" aria-label="Breadcrumb">
        <a href={`/${currentLang}/`} class="hover:text-cyan-dark dark:hover:text-cyan transition-colors">{t('nav.home')}</a>
        <span>/</span>
        <a href={`/${currentLang}/games/`} class="hover:text-cyan-dark dark:hover:text-cyan transition-colors">{t('nav.games')}</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-cloud-muted truncate font-medium">{game.title}</span>
      </nav>

      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
        <div class="max-w-3xl">
          <div class="flex flex-wrap items-center gap-2.5 mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-bold border border-cyan-500/40 bg-cyan-500/10 text-cyan-800 dark:text-cyan uppercase tracking-wider">
              {game.riskBadge}
            </span>
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-200/80 dark:bg-navy-800 text-slate-700 dark:text-cloud-muted border border-slate-300 dark:border-navy-700">
              {game.genre}
            </span>
            {game.platforms.map((p) => (
              <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-200/80 dark:bg-navy-800 text-slate-700 dark:text-cloud-muted border border-slate-300 dark:border-navy-700">
                {p}
              </span>
            ))}
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-slate-900 dark:text-cloud tracking-tight leading-tight mb-4">
            {game.title}
          </h1>

          <p class="text-base sm:text-lg text-slate-600 dark:text-cloud-muted leading-relaxed mb-6">
            {game.subtitle}
          </p>

          <div class="flex flex-wrap gap-2">
            {game.commonRiskTags.map((tag) => (
              <span class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-navy-800/90 text-slate-800 dark:text-cloud border border-slate-200 dark:border-navy-700 shadow-sm">
                ⚠ {tag}
              </span>
            ))}
          </div>

          <!-- Audit & Verification Badge -->
          <div class="mt-5 inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-xl border border-emerald-500/40 bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="font-semibold">{game.verificationStatus}</span>
            <span class="text-slate-400 dark:text-cloud-subtle">•</span>
            <span>{currentLang === 'ru' ? 'Аудит:' : 'Audited:'} {game.lastAuditedDate}</span>
          </div>
        </div>

        <!-- 3D Mascot Artwork Emblem with Floating Animation -->
        <div class="flex-shrink-0 mx-auto lg:mx-0 p-6 rounded-3xl bg-white dark:bg-navy-850 border border-slate-200 dark:border-navy-700 shadow-xl float-element-1">
          <GameArtwork type={game.svgArtwork as any} size="lg" />
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- SECTION 1: Most Common Scams & How They Work -->
    <section>
      <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-slate-900 dark:text-cloud mb-2 flex items-center gap-3">
          <span class="w-8 h-8 rounded-xl bg-orange-500/20 text-orange-600 dark:text-orange flex items-center justify-center text-sm font-bold">1</span>
          <span>{currentLang === 'en' ? 'Most Common Scams & Attack Mechanics' : 'Главные схемы обмана и механика атак'}</span>
        </h2>
        <p class="text-sm text-slate-600 dark:text-cloud-muted leading-relaxed">
          {currentLang === 'en'
            ? 'Understanding how bad actors execute these schemes protects you before suspicious trades or requests occur.'
            : 'Понимание внутренней логики атак позволяет вовремя остановиться и защитить инвентарь до того, как данные будут переданы.'}
        </p>
      </div>

      <div class="space-y-6">
        {game.scamScenarios.map((scenario, idx) => (
          <div class="rounded-2xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 p-6 sm:p-7 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <h3 class="text-lg font-heading font-bold text-slate-900 dark:text-cloud">
                {idx + 1}. {scenario.title}
              </h3>
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-navy-900 text-slate-700 dark:text-violet border border-slate-200 dark:border-navy-700">
                {scenario.threatType}
              </span>
            </div>

            <p class="text-sm text-slate-600 dark:text-cloud-muted leading-relaxed mb-4 font-medium">
              {scenario.summary}
            </p>

            <!-- How it works steps -->
            <div class="mb-4 p-4 rounded-xl bg-slate-50 dark:bg-navy-900 border border-slate-200 dark:border-navy-800">
              <span class="block text-xs font-bold uppercase tracking-wider text-cyan-dark dark:text-cyan mb-2">
                {currentLang === 'en' ? 'How the Scam Works Step-by-Step:' : 'Пошаговый сценарий развития атаки:'}
              </span>
              <ol class="space-y-2 list-decimal list-inside text-xs sm:text-sm text-slate-700 dark:text-cloud-muted">
                {scenario.howItWorks.map((step) => (
                  <li class="leading-relaxed pl-1">{step}</li>
                ))}
              </ol>
            </div>

            <!-- Red Flags -->
            <div>
              <span class="block text-xs font-bold uppercase tracking-wider text-orange-600 dark:text-orange mb-2">
                🚩 {currentLang === 'en' ? 'Critical Red Flags:' : 'Признаки опасности (Red Flags):'}
              </span>
              <ul class="space-y-1.5 text-xs sm:text-sm text-slate-700 dark:text-cloud-muted">
                {scenario.redFlags.map((flag) => (
                  <li class="flex items-start gap-2">
                    <span class="text-orange-500 font-bold">•</span>
                    <span>{flag}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 2: What NOT to Share (Critical Callout Box) -->
    <section class="rounded-3xl border-2 border-red-500/40 bg-red-500/5 p-6 sm:p-8">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-red-500/20 text-red-600 dark:text-red-400 flex items-center justify-center font-bold text-lg flex-shrink-0">
          ⛔
        </div>
        <div>
          <h2 class="text-xl sm:text-2xl font-heading font-extrabold text-red-600 dark:text-red-400">
            {currentLang === 'en' ? 'What You Must NEVER Share' : 'Что КАТЕГОРИЧЕСКИ нельзя передавать'}
          </h2>
          <p class="text-xs text-slate-600 dark:text-cloud-subtle">
            {currentLang === 'en'
              ? 'Handing over any of these items grants attackers direct access to your profile.'
              : 'Передача этих данных дает злоумышленникам мгновенный доступ к вашей учетной записи.'}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
        {game.whatNotToShare.map((item) => (
          <div class="flex items-start gap-2.5 p-3 rounded-xl bg-white/70 dark:bg-navy-900/70 border border-red-500/20 text-xs sm:text-sm text-slate-800 dark:text-cloud font-medium">
            <span class="text-red-500 font-bold">✕</span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 3: Account Protection Checklist -->
    <section class="rounded-3xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-xl bg-lime-500/20 text-lime-600 dark:text-lime flex items-center justify-center font-bold text-sm">
          ✓
        </div>
        <h2 class="text-xl sm:text-2xl font-heading font-extrabold text-slate-900 dark:text-cloud">
          {currentLang === 'en' ? `${game.title} Protection Checklist` : `Чек-лист защиты для ${game.title}`}
        </h2>
      </div>

      <ul class="space-y-3">
        {game.protectionChecklist.map((item) => (
          <li class="flex items-start gap-3 p-3.5 rounded-2xl bg-slate-50 dark:bg-navy-900 border border-slate-200 dark:border-navy-800 text-xs sm:text-sm text-slate-800 dark:text-cloud-muted leading-relaxed">
            <span class="w-5 h-5 rounded-full bg-lime-500/20 text-lime-600 dark:text-lime font-bold flex items-center justify-center text-xs flex-shrink-0 mt-0.5">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- SECTION 4: Payment & Currency Safety -->
    <section class="rounded-3xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 p-6 sm:p-8 shadow-sm">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-xl bg-violet-500/20 text-violet-600 dark:text-violet flex items-center justify-center font-bold text-sm">
          💳
        </div>
        <h2 class="text-xl sm:text-2xl font-heading font-extrabold text-slate-900 dark:text-cloud">
          {currentLang === 'en' ? 'Payment & Virtual Currency Rules' : 'Правила безопасности платежей и валюты'}
        </h2>
      </div>

      <ul class="space-y-3">
        {game.paymentSafetyGuidelines.map((guideline) => (
          <li class="flex items-start gap-3 text-xs sm:text-sm text-slate-700 dark:text-cloud-muted leading-relaxed">
            <span class="text-violet-500 font-bold">•</span>
            <span>{guideline}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- SECTION 5: What to Do If Compromised (Emergency Playbook) -->
    <section class="rounded-3xl border border-orange-500/40 bg-orange-500/5 p-6 sm:p-8">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-8 rounded-xl bg-orange-500/20 text-orange-600 dark:text-orange flex items-center justify-center font-bold text-sm">
          🚨
        </div>
        <h2 class="text-xl sm:text-2xl font-heading font-extrabold text-orange-600 dark:text-orange">
          {currentLang === 'en' ? 'What To Do If Account or Items Are Stolen' : 'Что делать при взломе или краже предметов'}
        </h2>
      </div>

      <div class="space-y-3">
        {game.incidentSteps.map((step) => (
          <div class="p-3.5 rounded-2xl bg-white dark:bg-navy-900 border border-orange-500/30 text-xs sm:text-sm text-slate-800 dark:text-cloud-muted leading-relaxed font-medium">
            {step}
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 6: Official Support & Security Resources -->
    <section class="rounded-3xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 p-6 sm:p-8 shadow-sm">
      <h2 class="text-xl sm:text-2xl font-heading font-extrabold text-slate-900 dark:text-cloud mb-4">
        {currentLang === 'en' ? 'Official Publisher Resources' : 'Официальные ресурсы разработчиков'}
      </h2>
      <p class="text-xs text-slate-500 dark:text-cloud-subtle mb-6">
        {currentLang === 'en'
          ? 'Always verify domains before typing credentials. Here are the genuine, verified support channels:'
          : 'Всегда проверяйте адресную строку перед вводом данных. Проверенные официальные ссылки:'}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {game.officialResources.map((res) => (
          <a
            href={res.url}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-2xl border border-slate-200 dark:border-navy-700 bg-slate-50 dark:bg-navy-900 hover:border-cyan hover:bg-slate-100 dark:hover:bg-navy-800 transition-all flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-heading font-bold text-xs sm:text-sm text-slate-900 dark:text-cloud group-hover:text-cyan-dark dark:group-hover:text-cyan transition-colors">
                  {res.title}
                </span>
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              <p class="text-[11px] text-slate-500 dark:text-cloud-subtle leading-relaxed">
                {res.description}
              </p>
            </div>
            <span class="mt-3 text-[10px] text-cyan-dark dark:text-cyan font-semibold truncate">
              {res.url}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- SECTION 7: Game-Specific Interactive Quiz -->
    <section class="rounded-3xl border border-slate-200 dark:border-navy-700 bg-slate-50 dark:bg-navy-850 p-6 sm:p-8 shadow-sm">
      <div class="text-center mb-6">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold border border-cyan-500/30 bg-cyan-500/10 text-cyan-700 dark:text-cyan mb-2">
          {currentLang === 'en' ? `${game.title} Mini-Drill` : `Мини-тест по ${game.title}`}
        </span>
        <h2 class="text-xl sm:text-2xl font-heading font-extrabold text-slate-900 dark:text-cloud">
          {currentLang === 'en' ? 'Quick Knowledge Check' : 'Проверьте себя'}
        </h2>
      </div>

      <div class="space-y-6">
        {game.quiz.map((q, qIndex) => (
          <div class="p-5 rounded-2xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800" data-game-quiz-item>
            <p class="text-xs sm:text-sm font-heading font-bold text-slate-900 dark:text-cloud mb-4">
              {qIndex + 1}. {q.question}
            </p>

            <div class="space-y-2 mb-3">
              {q.options.map((opt, optIdx) => (
                <button
                  type="button"
                  data-option-idx={optIdx}
                  data-correct-idx={q.correctIndex}
                  data-explanation={q.explanation}
                  class="w-full text-left p-3 rounded-xl border border-slate-200 dark:border-navy-700 bg-slate-50 dark:bg-navy-850 text-xs text-slate-800 dark:text-cloud-muted hover:border-cyan hover:bg-slate-100 dark:hover:bg-navy-800 transition-all font-medium flex items-start gap-2.5"
                >
                  <span class="w-4 h-4 rounded-full border border-slate-300 dark:border-navy-600 flex items-center justify-center text-[9px] font-bold mt-0.5">
                    {String.fromCharCode(65 + optIdx)}
                  </span>
                  <span>{opt}</span>
                </button>
              ))}
            </div>

            <!-- Feedback slot -->
            <div class="hidden p-3 rounded-xl text-xs leading-relaxed quiz-feedback"></div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 8: Related SafeInGame Articles -->
    {relatedArticles.length > 0 && (
      <section>
        <h2 class="text-xl sm:text-2xl font-heading font-extrabold text-slate-900 dark:text-cloud mb-6">
          {currentLang === 'en' ? 'Related In-Depth Threat Guides' : 'Связанные статьи по кибербезопасности'}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedArticles.map((art) => (
            <ThreatCard
              slug={art.slug}
              title={art.data.title}
              description={art.data.description}
              category={art.data.category}
              categoryTitle={art.data.category_title}
              readingTime={art.data.reading_time}
              warningSignsCount={art.data.warning_signs.length}
              currentLang={currentLang}
            />
          ))}
        </div>
      </section>
    )}

    <!-- SECTION 9: Educational Disclaimer -->
    <div class="p-4 rounded-2xl border border-slate-200 dark:border-navy-800 bg-slate-100 dark:bg-navy-950 text-center text-xs text-slate-500 dark:text-cloud-subtle leading-relaxed">
      {currentLang === 'en'
        ? 'Reminder: SafeInGame is an independent educational platform. We do not automatically detect scams or recover stolen accounts. Always contact official game support directly.'
        : 'Напоминание: SafeInGame — независимый образовательный проект. Мы не проводим автоматическое сканирование и не восстанавливаем доступ к чужим аккаунтам. Для возврата обращайтесь исключительно в официальную техподдержку издателя.'}
    </div>
  </div>
</BaseLayout>

<script>
  function setupGameQuiz() {
    const quizItems = document.querySelectorAll('[data-game-quiz-item]');

    quizItems.forEach((item) => {
      const buttons = item.querySelectorAll('button[data-option-idx]');
      const feedback = item.querySelector('.quiz-feedback') as HTMLElement | null;

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const optIdx = parseInt(btn.getAttribute('data-option-idx') || '-1', 10);
          const correctIdx = parseInt(btn.getAttribute('data-correct-idx') || '-1', 10);
          const explanation = btn.getAttribute('data-explanation') || '';

          // Disable buttons
          buttons.forEach((b) => ((b as HTMLButtonElement).disabled = true));

          if (feedback) {
            feedback.classList.remove('hidden');
            if (optIdx === correctIdx) {
              btn.className = 'w-full text-left p-3 rounded-xl border border-lime-500/50 bg-lime-500/10 text-slate-900 dark:text-cloud text-xs font-semibold flex items-start gap-2.5';
              feedback.className = 'mt-3 p-3 rounded-xl border border-lime-500/40 bg-lime-500/10 text-xs text-lime-800 dark:text-lime leading-relaxed font-medium';
              feedback.innerHTML = `<strong>✓ Верно / Correct:</strong> ${explanation}`;
            } else {
              btn.className = 'w-full text-left p-3 rounded-xl border border-red-500/50 bg-red-500/10 text-slate-900 dark:text-cloud text-xs font-semibold flex items-start gap-2.5';
              feedback.className = 'mt-3 p-3 rounded-xl border border-red-500/40 bg-red-500/10 text-xs text-red-800 dark:text-red-300 leading-relaxed font-medium';
              feedback.innerHTML = `<strong>✕ Ошибка / Incorrect:</strong> ${explanation}`;
            }
          }
        });
      });
    });
  }

  setupGameQuiz();
  document.addEventListener('astro:page-load', setupGameQuiz);
</script>
