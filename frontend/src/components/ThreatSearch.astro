---
import ThreatCard from './ThreatCard.astro';
import { useTranslations } from '../i18n/ui';

interface ArticleItem {
  slug: string;
  title: string;
  description: string;
  category: string;
  categoryTitle: string;
  readingTime: string;
  warningSignsCount: number;
}

interface CategoryOption {
  slug: string;
  title: string;
}

interface Props {
  articles: ArticleItem[];
  categories: CategoryOption[];
  currentLang: 'en' | 'ru';
  initialCategory?: string;
  initialQuery?: string;
}

const {
  articles,
  categories,
  currentLang,
  initialCategory = '',
  initialQuery = '',
} = Astro.props;

const t = useTranslations(currentLang);
---

<div class="space-y-8" id="threat-search-container">
  <!-- Controls: Search input + Category filter buttons -->
  <div class="flex flex-col md:flex-row gap-4 items-stretch md:items-center justify-between">
    <!-- Search Bar -->
    <div class="relative flex-grow max-w-xl">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 dark:text-cloud-subtle">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="search"
        id="search-input"
        value={initialQuery}
        placeholder={t('search.placeholder')}
        class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-850 text-slate-900 dark:text-cloud text-sm placeholder-slate-400 dark:placeholder-cloud-subtle focus:border-cyan-500 dark:focus:border-cyan focus:ring-1 focus:ring-cyan transition-all shadow-sm"
        aria-label="Search threat articles"
      />
    </div>

    <!-- Category Dropdown / Selector -->
    <div class="flex-shrink-0">
      <select
        id="category-select"
        class="w-full md:w-auto px-4 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-850 text-slate-900 dark:text-cloud text-sm focus:border-cyan-500 dark:focus:border-cyan focus:ring-1 focus:ring-cyan transition-all shadow-sm"
        aria-label="Filter by category"
      >
        <option value="">{t('search.all_categories')}</option>
        {categories.map((c) => (
          <option value={c.slug} selected={c.slug === initialCategory}>
            {c.title}
          </option>
        ))}
      </select>
    </div>
  </div>

  <!-- Category Pills for quick filtering on desktop -->
  <div class="hidden sm:flex flex-wrap items-center justify-between gap-2 pt-1 pb-2">
    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        data-category=""
        class="filter-pill px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all duration-200 border-cyan-500 bg-cyan-500/15 text-cyan-800 dark:text-cyan"
      >
        {t('search.all_categories')}
      </button>
      {categories.map((c) => (
        <button
          type="button"
          data-category={c.slug}
          class="filter-pill px-3 py-1.5 rounded-lg text-xs font-medium border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-850 text-slate-700 dark:text-cloud-muted hover:text-slate-900 dark:hover:text-cloud hover:border-slate-400 dark:hover:border-navy-600 transition-all duration-200 shadow-sm"
        >
          {c.title}
        </button>
      ))}
    </div>

    <!-- Live counter badge -->
    <div class="text-xs font-mono font-medium text-slate-500 dark:text-cloud-subtle bg-slate-100 dark:bg-navy-850 px-3 py-1 rounded-md border border-slate-200 dark:border-navy-700">
      <span id="threat-visible-count">{articles.length}</span> / <span id="threat-total-count">{articles.length}</span> {currentLang === 'ru' ? 'статей' : 'guides'}
    </div>
  </div>

  <!-- Articles Grid -->
  <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {articles.map((item) => (
      <div
        class="threat-item"
        data-slug={item.slug}
        data-title={item.title.toLowerCase()}
        data-description={item.description.toLowerCase()}
        data-category={item.category}
      >
        <ThreatCard
          slug={item.slug}
          title={item.title}
          description={item.description}
          category={item.category}
          categoryTitle={item.categoryTitle}
          readingTime={item.readingTime}
          warningSignsCount={item.warningSignsCount}
          currentLang={currentLang}
        />
      </div>
    ))}
  </div>

  <!-- Empty State (Shown when search/filter yields zero results) -->
  <div id="no-results-state" class="hidden py-16 text-center rounded-2xl border border-dashed border-slate-300 dark:border-navy-700 bg-slate-50 dark:bg-navy-850/50">
    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-200 dark:bg-navy-800 flex items-center justify-center text-slate-500 dark:text-cloud-subtle">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h3 class="text-lg font-heading font-bold text-slate-900 dark:text-cloud mb-2">
      {t('search.no_results')}
    </h3>
    <p class="text-sm text-slate-600 dark:text-cloud-muted max-w-md mx-auto mb-6">
      {currentLang === 'en'
        ? 'Try refining your query or select a different category to view related security guides.'
        : 'Попробуйте изменить поисковый запрос или выберите другую категорию угроз.'}
    </p>
    <button
      id="reset-filter-btn"
      type="button"
      class="px-4 py-2 rounded-xl bg-slate-200 hover:bg-slate-300 dark:bg-navy-700 dark:hover:bg-navy-600 text-slate-900 dark:text-cloud text-sm font-semibold transition-colors"
    >
      {t('search.reset')}
    </button>
  </div>
</div>

<script>
  function setupSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const select = document.getElementById('category-select') as HTMLSelectElement | null;
    const pills = document.querySelectorAll('.filter-pill');
    const items = document.querySelectorAll('.threat-item') as NodeListOf<HTMLElement>;
    const emptyState = document.getElementById('no-results-state');
    const resetBtn = document.getElementById('reset-filter-btn');

    const visibleCountEl = document.getElementById('threat-visible-count');
    const totalCountEl = document.getElementById('threat-total-count');
    let debounceTimer: ReturnType<typeof setTimeout> | null = null;

    if (totalCountEl) totalCountEl.textContent = String(items.length);

    // Parse URL params on load
    const params = new URLSearchParams(window.location.search);
    const paramCategory = params.get('category') || '';
    const paramQuery = params.get('q') || '';

    if (input && paramQuery) input.value = paramQuery;
    if (select && paramCategory) select.value = paramCategory;

    function applyFilter() {
      const q = (input?.value || '').toLowerCase().trim();
      const cat = select?.value || '';

      // Update pills appearance
      pills.forEach((pill) => {
        const pillCat = pill.getAttribute('data-category') || '';
        if (pillCat === cat) {
          pill.className = 'filter-pill px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all duration-200 border-cyan-500 bg-cyan-500/15 text-cyan-800 dark:text-cyan';
        } else {
          pill.className = 'filter-pill px-3 py-1.5 rounded-lg text-xs font-medium border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-850 text-slate-700 dark:text-cloud-muted hover:text-slate-900 dark:hover:text-cloud hover:border-slate-400 dark:hover:border-navy-600 transition-all duration-200 shadow-sm';
        }
      });

      let visibleCount = 0;

      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const desc = item.getAttribute('data-description') || '';
        const itemCat = item.getAttribute('data-category') || '';

        const matchesCat = !cat || itemCat === cat;
        const matchesQuery = !q || title.includes(q) || desc.includes(q);

        if (matchesCat && matchesQuery) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (visibleCountEl) {
        visibleCountEl.textContent = String(visibleCount);
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      // Sync URL without reloading
      const newUrl = new URL(window.location.href);
      if (cat) newUrl.searchParams.set('category', cat);
      else newUrl.searchParams.delete('category');
      if (q) newUrl.searchParams.set('q', q);
      else newUrl.searchParams.delete('q');
      window.history.replaceState({}, '', newUrl.toString());
    }

    // Debounce search input to prevent rapid reflows
    input?.addEventListener('input', () => {
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFilter, 150);
    });

    select?.addEventListener('change', applyFilter);

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-category') || '';
        if (select) select.value = cat;
        applyFilter();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      if (select) select.value = '';
      applyFilter();
    });

    // Run initial filter if URL parameters exist
    if (paramCategory || paramQuery) {
      applyFilter();
    }
  }

  // Run on first load
  setupSearch();
  // Support Astro View Transitions if enabled
  document.addEventListener('astro:page-load', setupSearch);
</script>
