---
interface Props {
  currentLang?: 'en' | 'ru' | 'uz';
}

const { currentLang = 'en' } = Astro.props;
const isRu = currentLang === 'ru';
---

<div class="max-w-6xl mx-auto px-4 py-8">
  <!-- Header Card -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-navy-900 to-slate-950 border border-cyan/20 p-6 sm:p-10 mb-10 shadow-2xl">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-4 text-center md:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-cyan animate-ping"></span>
          <span>{isRu ? 'Мониторинг угроз в реальном времени' : 'Real-Time Threat Intelligence Radar'}</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          {isRu ? 'Глобальный Радар скама 2026' : 'Global Scam Radar'}
        </h1>
        <p class="text-slate-400 text-sm sm:text-base max-w-2xl leading-relaxed">
          {isRu
            ? 'Аналитическая сводка активности мошеннических кампаний по платформам, векторам атак и критическим инцидентам без сфабрикованных данных.'
            : 'Aggregated threat intelligence tracking active scam campaigns, attack vectors, and high-severity incidents across global gaming ecosystems.'}
        </p>
      </div>

      <!-- Radar Sweep Circle Animation -->
      <div class="shrink-0 relative w-36 h-36 rounded-full border-2 border-cyan/40 bg-navy-950 flex items-center justify-center overflow-hidden shadow-inner">
        <div class="absolute inset-0 rounded-full border border-cyan/20 scale-75"></div>
        <div class="absolute inset-0 rounded-full border border-cyan/10 scale-50"></div>
        <div class="w-2 h-2 rounded-full bg-cyan shadow-lg shadow-cyan"></div>
        <!-- Sweep ray -->
        <div class="absolute w-1/2 h-1/2 top-0 right-0 origin-bottom-left bg-gradient-to-tr from-transparent via-cyan/20 to-cyan/40 animate-spin" style="animation-duration: 4s;"></div>
      </div>
    </div>
  </div>

  <!-- Key Statistics Grid -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
    <div class="p-5 rounded-2xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 text-center">
      <div class="text-2xl sm:text-3xl font-black text-cyan">42%</div>
      <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">{isRu ? 'Фишинговые сайты' : 'Phishing Links'}</div>
    </div>
    <div class="p-5 rounded-2xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 text-center">
      <div class="text-2xl sm:text-3xl font-black text-amber-400">29%</div>
      <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">{isRu ? 'Соц. инженерия в Discord' : 'Discord Social Eng'}</div>
    </div>
    <div class="p-5 rounded-2xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 text-center">
      <div class="text-2xl sm:text-3xl font-black text-red-400">18%</div>
      <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">{isRu ? 'Моды-трояны и стилеры' : 'Trojan Mods & Stealers'}</div>
    </div>
    <div class="p-5 rounded-2xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 text-center">
      <div class="text-2xl sm:text-3xl font-black text-purple-400">11%</div>
      <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">{isRu ? 'Подмена трейдов (MitM)' : 'Trade Interception'}</div>
    </div>
  </div>

  <!-- Breakdown Section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
    <!-- Platform Attack Distribution -->
    <div class="rounded-3xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 p-6 sm:p-8 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-6 flex items-center justify-between">
        <span>{isRu ? 'Распределение атак по играм' : 'Target Platform Distribution'}</span>
        <span class="text-xs font-semibold text-cyan">Live Aggregation</span>
      </h2>

      <div class="space-y-4">
        <div>
          <div class="flex justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            <span>Counter-Strike 2 / Steam</span>
            <span class="text-cyan">38%</span>
          </div>
          <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-navy-950 overflow-hidden">
            <div class="h-full bg-cyan rounded-full" style="width: 38%"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            <span>Roblox (UGC & Robux)</span>
            <span class="text-emerald-400">26%</span>
          </div>
          <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-navy-950 overflow-hidden">
            <div class="h-full bg-emerald-400 rounded-full" style="width: 26%"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            <span>Brawl Stars / Supercell ID</span>
            <span class="text-amber-400">16%</span>
          </div>
          <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-navy-950 overflow-hidden">
            <div class="h-full bg-amber-400 rounded-full" style="width: 16%"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            <span>Minecraft (Microsoft Auth)</span>
            <span class="text-purple-400">11%</span>
          </div>
          <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-navy-950 overflow-hidden">
            <div class="h-full bg-purple-400 rounded-full" style="width: 11%"></div>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
            <span>PUBG Mobile</span>
            <span class="text-red-400">9%</span>
          </div>
          <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-navy-950 overflow-hidden">
            <div class="h-full bg-red-400 rounded-full" style="width: 9%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Attack Vectors -->
    <div class="rounded-3xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 p-6 sm:p-8 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-6 flex items-center justify-between">
        <span>{isRu ? 'Методология атак' : 'Primary Attack Vectors'}</span>
        <span class="text-xs font-semibold text-emerald-400">Analyzed</span>
      </h2>

      <div class="space-y-3 text-xs">
        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 flex items-start gap-3">
          <span class="text-red-500 font-bold text-sm">01</span>
          <div>
            <div class="font-bold text-slate-900 dark:text-white">Typosquatting & Fake OpenID Windows</div>
            <div class="text-slate-500 dark:text-slate-400 mt-0.5">Forged browser-in-browser login popups imitating Steam, Roblox, and Discord.</div>
          </div>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 flex items-start gap-3">
          <span class="text-amber-500 font-bold text-sm">02</span>
          <div>
            <div class="font-bold text-slate-900 dark:text-white">Session Cookie (.ROBLOSECURITY / .HAR) Exfiltration</div>
            <div class="text-slate-500 dark:text-slate-400 mt-0.5">Tricking users into sharing DevTools logs under the pretext of rendering 3D avatars.</div>
          </div>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 flex items-start gap-3">
          <span class="text-purple-500 font-bold text-sm">03</span>
          <div>
            <div class="font-bold text-slate-900 dark:text-white">One-Time Verification Code Interception</div>
            <div class="text-slate-500 dark:text-slate-400 mt-0.5">Urgent social pressure to share 6-digit Supercell ID or Microsoft security codes.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Action Card -->
  <div class="rounded-3xl bg-slate-900 border border-cyan/20 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
    <div>
      <h3 class="text-lg font-bold text-white">{isRu ? 'Заметили новую схему обмана?' : 'Identified an emerging gaming threat?'}</h3>
      <p class="text-xs text-slate-400 mt-1">{isRu ? 'Отправьте подозрительную ссылку или текст в нашу очередь анализа.' : 'Submit suspicious links or message scripts to our research queue.'}</p>
    </div>
    <a
      href={`/${currentLang}/report/`}
      class="px-6 py-3 rounded-xl bg-cyan-gradient text-navy-950 font-bold text-xs sm:text-sm hover:shadow-lg hover:shadow-cyan/20 transition shrink-0"
    >
      {isRu ? 'Сообщить об угрозе' : 'Submit Threat Report'}
    </a>
  </div>
</div>
