---
interface Props {
  currentLang?: 'en' | 'ru';
}

const { currentLang = 'en' } = Astro.props;
const isRu = currentLang === 'ru';

const labels = {
  badge: isRu ? 'Глобальный мониторинг угроз' : 'Global Threat Radar Live',
  title: isRu ? '3D Карта кибератак на геймеров' : '3D Global Gamer Cyber Attack Map',
  subtitle: isRu 
    ? 'Интерактивная 3D-телеметрия перехваченных фишинговых волн, атак на Steam API и краж игровых сессий по странам в реальном времени.'
    : 'Real-time 3D interactive telemetry tracking intercepted gaming phishing campaigns, session hijacks, and tournament scams across active regions.',
  stat1: isRu ? 'Атак отражено за сутки' : 'Attacks Blocked (24h)',
  stat2: isRu ? 'Активных векторов' : 'Active Scam Vectors',
  stat3: isRu ? 'Эффективность защиты' : 'Defense Success Rate',
  stat4: isRu ? 'Среднее время нейтрализации' : 'Avg Intercept Time',
  filterAll: isRu ? 'Все угрозы' : 'All Threats',
  liveFeedTitle: isRu ? 'Лента перехватов в реальном времени' : 'Live Attack Interceptions Feed',
  hotspotsTitle: isRu ? 'Активные очаги атак' : 'Active Attack Hotspots',
  country: isRu ? 'Страна' : 'Region',
  threatVector: isRu ? 'Вектор атаки' : 'Threat Vector',
  intensity: isRu ? 'Интенсивность' : 'Intensity',
  statusLive: isRu ? 'В РЕАЛЬНОМ ВРЕМЕНИ' : 'LIVE STREAM',
};

// Preset attack hubs with realistic coordinates on 1000x500 SVG world map
const attackNodes = [
  { id: 'ru', name: isRu ? 'Восточная Европа / СНГ' : 'Eastern Europe / CIS', x: 620, y: 130, flag: '🇷🇺', level: 'CRITICAL', scam: 'Steam BitB & API Phishing', game: 'CS2 / Steam', count: '4,890 / 24ч' },
  { id: 'us-e', name: isRu ? 'США (Восточное побережье)' : 'USA (East Coast)', x: 270, y: 165, flag: '🇺🇸', level: 'HIGH', scam: 'Roblox .HAR Cookie Stealer', game: 'Roblox', count: '3,410 / 24ч' },
  { id: 'us-w', name: isRu ? 'США (Западное побережье)' : 'USA (West Coast)', x: 140, y: 175, flag: '🇺🇸', level: 'HIGH', scam: 'Discord Nitro OAuth Token Grab', game: 'Discord', count: '2,940 / 24ч' },
  { id: 'br', name: isRu ? 'Бразилия (Сан-Паулу)' : 'Brazil (São Paulo)', x: 310, y: 375, flag: '🇧🇷', level: 'ELEVATED', scam: 'Fake Skin Roulette & APK', game: 'Brawl Stars', count: '1,820 / 24ч' },
  { id: 'de', name: isRu ? 'Западная Европа (Германия)' : 'Western Europe (Germany)', x: 505, y: 145, flag: '🇩🇪', level: 'HIGH', scam: 'Fake FaceIT Tournament Phish', game: 'CS2', count: '2,150 / 24ч' },
  { id: 'sea', name: isRu ? 'Юго-Восточная Азия' : 'Southeast Asia (PH/ID)', x: 805, y: 300, flag: '🇵🇭', level: 'CRITICAL', scam: 'Fake Gem Generators & Mod APK', game: 'Brawl Stars / Roblox', count: '3,880 / 24ч' },
  { id: 'tr', name: isRu ? 'Турция / Ближний Восток' : 'Turkey / Middle East', x: 585, y: 195, flag: '🇹🇷', level: 'ELEVATED', scam: 'Discount Currency & Gift Fraud', game: 'PUBG / Steam', count: '1,450 / 24ч' },
  { id: 'ea', name: isRu ? 'Восточная Азия' : 'East Asia (KR/JP)', x: 875, y: 170, flag: '🇯🇵', level: 'MODERATE', scam: 'Credential Stuffing Botnets', game: 'Minecraft / Steam', count: '980 / 24ч' },
];

// Arcs between attacker hubs and target gamer clusters
const trajectories = [
  { from: [620, 130], to: [505, 145], color: '#6C8CFF' }, // RU -> DE
  { from: [620, 130], to: [270, 165], color: '#48D6E8' }, // RU -> US-E
  { from: [805, 300], to: [875, 170], color: '#A78BFA' }, // SEA -> EA
  { from: [140, 175], to: [270, 165], color: '#48D6E8' }, // US-W -> US-E
  { from: [310, 375], to: [270, 165], color: '#F87171' }, // BR -> US-E
  { from: [585, 195], to: [505, 145], color: '#FBBF24' }, // TR -> DE
  { from: [805, 300], to: [620, 130], color: '#4ADE80' }, // SEA -> CIS
];

// Realistic World Continents High-Detail Geometry
const continentPaths = [
  // North America
  "M 80,65 L 110,50 L 160,45 L 205,52 L 245,45 L 275,55 L 285,80 L 260,95 L 280,115 L 295,100 L 315,115 L 300,140 L 265,145 L 255,160 L 270,175 L 290,170 L 305,185 L 285,195 L 275,225 L 255,220 L 245,240 L 225,245 L 205,275 L 195,295 L 180,280 L 190,250 L 165,230 L 155,200 L 135,185 L 130,150 L 105,140 L 85,110 L 70,85 Z",
  // Greenland
  "M 335,35 L 385,30 L 415,55 L 395,85 L 360,95 L 340,75 Z",
  // South America
  "M 215,295 L 245,290 L 285,305 L 325,310 L 360,335 L 350,375 L 320,410 L 305,450 L 285,480 L 275,475 L 280,440 L 270,390 L 245,350 L 230,320 Z",
  // Europe
  "M 465,95 L 490,80 L 530,75 L 565,85 L 560,115 L 535,130 L 550,150 L 535,175 L 505,180 L 485,195 L 465,185 L 455,160 L 475,145 L 450,135 L 455,110 Z",
  // UK & Ireland
  "M 445,100 L 460,95 L 455,120 L 440,125 Z M 430,110 L 440,105 L 435,120 L 428,118 Z",
  // Scandinavia
  "M 495,45 L 525,40 L 545,60 L 530,95 L 510,105 L 500,80 Z",
  // Africa
  "M 460,200 L 505,190 L 555,200 L 595,230 L 600,270 L 575,310 L 550,355 L 535,405 L 505,420 L 485,390 L 480,340 L 450,295 L 440,250 L 445,215 Z",
  // Madagascar
  "M 605,370 L 618,365 L 615,405 L 600,410 Z",
  // Asia & Russia
  "M 565,85 L 620,70 L 690,60 L 760,55 L 835,65 L 890,75 L 935,90 L 910,125 L 870,135 L 880,165 L 850,190 L 825,180 L 810,215 L 775,230 L 735,260 L 700,245 L 690,210 L 650,205 L 615,225 L 585,215 L 565,180 L 575,135 Z",
  // Japan
  "M 885,150 L 905,145 L 900,180 L 880,195 L 875,175 Z M 895,125 L 915,120 L 910,140 L 895,142 Z",
  // Southeast Asia Islands
  "M 745,260 L 780,265 L 795,295 L 775,315 L 755,290 Z M 785,320 L 830,325 L 820,345 L 780,340 Z M 835,280 L 855,275 L 850,310 L 830,305 Z",
  // Australia
  "M 790,360 L 840,345 L 885,365 L 895,405 L 865,440 L 825,445 L 785,415 L 780,380 Z",
  // New Zealand
  "M 920,430 L 935,425 L 925,460 L 915,455 Z",
];
---

<div class="cyber-attack-map-container rounded-3xl border border-ds-border bg-ds-surface/90 backdrop-blur-xl p-5 sm:p-7 shadow-premium relative overflow-hidden my-8">
  <!-- Ambient background glow -->
  <div class="absolute -top-32 -left-32 w-80 h-80 bg-ds-accent/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-ds-cyber/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6 relative z-10">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/25 text-red-400 text-xs font-bold uppercase tracking-wider mb-2">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
        <span>{labels.badge}</span>
        <span class="text-ds-text2 font-normal">|</span>
        <span class="text-emerald-400 font-semibold">{labels.statusLive}</span>
      </div>
      <h2 class="font-heading font-extrabold text-2xl sm:text-3xl text-ds-text tracking-tight">
        {labels.title}
      </h2>
      <p class="text-sm text-ds-text2 max-w-2xl mt-1">
        {labels.subtitle}
      </p>
    </div>

    <!-- Live Game Filter Pills -->
    <div class="flex flex-wrap items-center gap-1.5 self-start lg:self-center bg-black/10 dark:bg-black/40 p-1.5 rounded-2xl border border-ds-border">
      <button class="map-filter-btn active px-3 py-1.5 rounded-xl text-xs font-bold transition-all bg-ds-accent text-white" data-filter="all">
        {labels.filterAll}
      </button>
      <button class="map-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-ds-text2 hover:text-ds-text hover:bg-white/5 transition-all" data-filter="steam">
        CS2 / Steam
      </button>
      <button class="map-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-ds-text2 hover:text-ds-text hover:bg-white/5 transition-all" data-filter="roblox">
        Roblox
      </button>
      <button class="map-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-ds-text2 hover:text-ds-text hover:bg-white/5 transition-all" data-filter="brawl">
        Brawl Stars
      </button>
      <button class="map-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-ds-text2 hover:text-ds-text hover:bg-white/5 transition-all" data-filter="discord">
        Discord
      </button>
    </div>
  </div>

  <!-- Key Metrics Row -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mb-6 relative z-10">
    <div class="p-3.5 sm:p-4 rounded-2xl bg-ds-surface2/60 border border-ds-border flex flex-col">
      <span class="text-[11px] sm:text-xs text-ds-text2 font-medium">{labels.stat1}</span>
      <div class="flex items-baseline gap-2 mt-1">
        <span class="font-heading font-black text-xl sm:text-2xl text-ds-text" id="attacks-counter">14,892</span>
        <span class="text-[10px] text-emerald-400 font-bold">+12%</span>
      </div>
    </div>
    <div class="p-3.5 sm:p-4 rounded-2xl bg-ds-surface2/60 border border-ds-border flex flex-col">
      <span class="text-[11px] sm:text-xs text-ds-text2 font-medium">{labels.stat2}</span>
      <div class="flex items-baseline gap-2 mt-1">
        <span class="font-heading font-black text-xl sm:text-2xl text-amber-400">18</span>
        <span class="text-[10px] text-ds-text2">{isRu ? 'активных' : 'active'}</span>
      </div>
    </div>
    <div class="p-3.5 sm:p-4 rounded-2xl bg-ds-surface2/60 border border-ds-border flex flex-col">
      <span class="text-[11px] sm:text-xs text-ds-text2 font-medium">{labels.stat3}</span>
      <div class="flex items-baseline gap-2 mt-1">
        <span class="font-heading font-black text-xl sm:text-2xl text-emerald-400">99.6%</span>
        <span class="text-[10px] text-emerald-400 font-bold">{isRu ? 'Отражено' : 'Mitigated'}</span>
      </div>
    </div>
    <div class="p-3.5 sm:p-4 rounded-2xl bg-ds-surface2/60 border border-ds-border flex flex-col">
      <span class="text-[11px] sm:text-xs text-ds-text2 font-medium">{labels.stat4}</span>
      <div class="flex items-baseline gap-2 mt-1">
        <span class="font-heading font-black text-xl sm:text-2xl text-ds-cyber">1.2 сек</span>
        <span class="text-[10px] text-ds-cyber">AI Detect</span>
      </div>
    </div>
  </div>

  <!-- Interactive 3D Holographic Map Stage -->
  <div class="map-3d-stage relative w-full mb-6">
    <div
      id="map-3d-viewport"
      class="map-3d-viewport relative w-full rounded-3xl cyber-map-canvas p-2 sm:p-5 overflow-hidden transition-all duration-300"
    >
      <!-- Grid pattern background inside map -->
      <div class="absolute inset-0 bg-[radial-gradient(#6C8CFF_1px,transparent_1px)] [background-size:24px_24px] opacity-10 pointer-events-none"></div>

      <!-- Interactive SVG Map -->
      <div class="relative w-full aspect-[2/1] min-h-[320px] sm:min-h-[440px]">
        <svg
          viewBox="0 0 1000 500"
          class="w-full h-full select-none"
          xmlns="http://www.w3.org/2000/svg"
          id="world-map-svg"
        >
          <defs>
            <!-- Attack Trajectory Gradient -->
            <linearGradient id="attackGradCyan" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#48D6E8" stop-opacity="0.9"/>
              <stop offset="100%" stop-color="#6C8CFF" stop-opacity="0.2"/>
            </linearGradient>
            <linearGradient id="attackGradRed" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#F87171" stop-opacity="0.9"/>
              <stop offset="100%" stop-color="#FBBF24" stop-opacity="0.2"/>
            </linearGradient>
            
            <!-- Radar sweep gradients -->
            <linearGradient id="radarSweepGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#48D6E8" stop-opacity="0.8"/>
              <stop offset="100%" stop-color="#48D6E8" stop-opacity="0"/>
            </linearGradient>
            <radialGradient id="radarConeGrad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#48D6E8" stop-opacity="0.18"/>
              <stop offset="100%" stop-color="#48D6E8" stop-opacity="0"/>
            </radialGradient>

            <!-- Glow Filter -->
            <filter id="glowFilter" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="3" result="blur" />
              <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
          </defs>

          <!-- Coordinate Grid Lines & Radar Range Rings -->
          <g class="map-grid-lines">
            <circle cx="500" cy="250" r="140" fill="none" class="map-grid-line" stroke-dasharray="3,4" />
            <circle cx="500" cy="250" r="280" fill="none" class="map-grid-line" stroke-dasharray="4,6" />
            <circle cx="500" cy="250" r="420" fill="none" class="map-grid-line" stroke-dasharray="4,8" />
            <line x1="50" y1="125" x2="950" y2="125" class="map-grid-line" stroke-dasharray="2,4" />
            <line x1="50" y1="250" x2="950" y2="250" class="map-grid-line" stroke-dasharray="2,4" />
            <line x1="50" y1="375" x2="950" y2="375" class="map-grid-line" stroke-dasharray="2,4" />
            <line x1="250" y1="50" x2="250" y2="450" class="map-grid-line" stroke-dasharray="2,4" />
            <line x1="500" y1="50" x2="500" y2="450" class="map-grid-line" stroke-dasharray="2,4" />
            <line x1="750" y1="50" x2="750" y2="450" class="map-grid-line" stroke-dasharray="2,4" />
          </g>

          <!-- Rotating Radar Sweep Beam -->
          <g class="radar-sweep-beam pointer-events-none opacity-25 dark:opacity-35">
            <line x1="500" y1="250" x2="940" y2="250" stroke="url(#radarSweepGrad)" stroke-width="2" />
            <path d="M 500 250 L 920 250 A 420 420 0 0 0 790 30 Z" fill="url(#radarConeGrad)" />
          </g>

          <!-- ── LAYER 1: 3D Depth Extrusion Shadow Layer ── -->
          <g class="continents-3d-shadow" transform="translate(0, 6)">
            {continentPaths.map(d => (
              <path d={d} />
            ))}
          </g>

          <!-- ── LAYER 2: Elevated Continent Landmass Surfaces ── -->
          <g class="continents-surface">
            {continentPaths.map(d => (
              <path d={d} />
            ))}
          </g>

          <!-- ── LAYER 3: Razor-Sharp Coastline Outlines ── -->
          <g class="continents-coastline">
            {continentPaths.map(d => (
              <path d={d} />
            ))}
          </g>

          <!-- Animated Parabolic Attack Arcs -->
          <g id="attack-trajectories">
            {trajectories.map((traj, idx) => {
              const mx = (traj.from[0] + traj.to[0]) / 2;
              const my = Math.min(traj.from[1], traj.to[1]) - 40 - (idx * 6);
              const pathD = `M ${traj.from[0]} ${traj.from[1]} Q ${mx} ${my} ${traj.to[0]} ${traj.to[1]}`;
              return (
                <g class="attack-arc-group">
                  <path
                    d={pathD}
                    fill="none"
                    stroke={traj.color}
                    stroke-width="1.8"
                    stroke-opacity="0.45"
                    stroke-dasharray="6,6"
                    class="attack-path"
                  />
                  <!-- Animated energy missile dot along path -->
                  <circle r="3.5" fill={traj.color} opacity="0.95">
                    <animateMotion
                      path={pathD}
                      dur={`${2.2 + (idx % 3) * 0.8}s`}
                      repeatCount="indefinite"
                    />
                  </circle>
                </g>
              );
            })}
          </g>

          <!-- Threat Node Beacons -->
          <g id="attack-nodes">
            {attackNodes.map(node => (
              <g
                class="map-node-target cursor-pointer group"
                data-node-id={node.id}
                data-game={node.game}
                transform={`translate(${node.x}, ${node.y})`}
              >
                <!-- Outer pulse circle -->
                <circle
                  r="16"
                  fill="none"
                  stroke={node.level === 'CRITICAL' ? '#EF4444' : node.level === 'HIGH' ? '#F59E0B' : '#0284C7'}
                  stroke-opacity="0.4"
                  class="animate-ping origin-center"
                  style="animation-duration: 2.5s;"
                />
                <!-- Mid beacon ring -->
                <circle
                  r="8"
                  fill={node.level === 'CRITICAL' ? 'rgba(239,68,68,0.25)' : 'rgba(2,132,199,0.25)'}
                  stroke={node.level === 'CRITICAL' ? '#EF4444' : '#0284C7'}
                  stroke-width="1.8"
                />
                <!-- Center solid dot -->
                <circle
                  r="3.5"
                  fill={node.level === 'CRITICAL' ? '#EF4444' : '#0284C7'}
                />

                <!-- Hover Tooltip Pin -->
                <g class="node-tooltip opacity-90 group-hover:opacity-100 transition-opacity">
                  <rect
                    x="-65"
                    y="-42"
                    width="130"
                    height="32"
                    rx="8"
                    class="tooltip-box"
                    stroke={node.level === 'CRITICAL' ? '#EF4444' : '#3B82F6'}
                    stroke-width="1"
                    filter="url(#glowFilter)"
                  />
                  <text x="0" y="-28" text-anchor="middle" class="tooltip-text-main" font-size="10" font-weight="bold" font-family="sans-serif">
                    {node.flag} {node.id.toUpperCase()} • {node.game}
                  </text>
                  <text x="0" y="-16" text-anchor="middle" class="tooltip-text-sub" font-size="8.5" font-family="sans-serif">
                    {node.scam.slice(0, 22)}
                  </text>
                </g>
              </g>
            ))}
          </g>
        </svg>
      </div>

      <!-- Active Hotspot Detail Bar (Updates on Hover / Tap) -->
      <div id="hotspot-detail-bar" class="mt-3 p-3.5 rounded-2xl bg-ds-surface border border-ds-border flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs shadow-md">
        <div class="flex items-center gap-2.5">
          <span class="text-xl" id="detail-flag">🇷🇺</span>
          <div>
            <span class="font-bold text-ds-text text-sm" id="detail-title">Восточная Европа / СНГ</span>
            <span class="text-ds-text2 ml-2" id="detail-scam">Steam BitB & API Phishing</span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="px-2.5 py-1 rounded-lg bg-red-500/20 text-red-500 font-bold border border-red-500/30 uppercase text-[10px]" id="detail-level">CRITICAL</span>
          <span class="text-ds-text font-bold" id="detail-count">4,890 атак / 24ч</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Panel: Live Attack Intercept Feed & Top Scam Vectors -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 relative z-10">
    <!-- Live Stream Feed (2 columns) -->
    <div class="lg:col-span-2 rounded-2xl bg-ds-surface2/40 border border-ds-border p-4">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <h3 class="font-heading font-bold text-sm text-ds-text">{labels.liveFeedTitle}</h3>
        </div>
        <span class="text-[11px] text-ds-text2 font-mono" id="live-time-ticker">14:52:10 UTC</span>
      </div>

      <div class="space-y-2 overflow-hidden" id="live-feed-ticker" style="max-height: 220px;">
        <!-- Feed items dynamically pushed here -->
        <div class="feed-item p-2.5 rounded-xl bg-ds-surface/80 border border-ds-border flex items-center justify-between gap-3 text-xs animate-fadeIn">
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-base flex-shrink-0">🇷🇺 ➔ 🇩🇪</span>
            <span class="font-bold text-ds-text truncate">cs2-faceit-championship.net</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] bg-red-500/20 text-red-400 font-mono flex-shrink-0">BitB Phish</span>
          </div>
          <div class="text-right flex-shrink-0">
            <span class="text-emerald-400 font-bold font-mono">+$850 SAVED</span>
            <span class="text-[10px] text-ds-text2 block">{isRu ? '1 сек назад' : '1s ago'}</span>
          </div>
        </div>

        <div class="feed-item p-2.5 rounded-xl bg-ds-surface/80 border border-ds-border flex items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-base flex-shrink-0">🇺🇸 ➔ 🇺🇸</span>
            <span class="font-bold text-ds-text truncate">roblox-cookie-auth.cc</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] bg-amber-500/20 text-amber-400 font-mono flex-shrink-0">.HAR Grabber</span>
          </div>
          <div class="text-right flex-shrink-0">
            <span class="text-emerald-400 font-bold font-mono">+$320 SAVED</span>
            <span class="text-[10px] text-ds-text2 block">{isRu ? '3 сек назад' : '3s ago'}</span>
          </div>
        </div>

        <div class="feed-item p-2.5 rounded-xl bg-ds-surface/80 border border-ds-border flex items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2 min-w-0">
            <span class="text-base flex-shrink-0">🇵🇭 ➔ 🇧🇷</span>
            <span class="font-bold text-ds-text truncate">free-brawl-gems2026.app</span>
            <span class="px-1.5 py-0.5 rounded text-[10px] bg-purple-500/20 text-purple-400 font-mono flex-shrink-0">Fake APK</span>
          </div>
          <div class="text-right flex-shrink-0">
            <span class="text-emerald-400 font-bold font-mono">BLOCKED</span>
            <span class="text-[10px] text-ds-text2 block">{isRu ? '6 сек назад' : '6s ago'}</span>
          </div>
        </div>

