<script>
  // ── Node Data for Detail Bar updates ──
  const nodeDetails: Record<string, { flag: string; title: string; scam: string; level: string; count: string }> = {
    'ru': { flag: '🇷🇺', title: 'Восточная Европа / СНГ', scam: 'Steam BitB & API Phishing', level: 'CRITICAL', count: '4,890 атак / 24ч' },
    'us-e': { flag: '🇺🇸', title: 'США (Восток)', scam: 'Roblox .HAR Cookie Grabber', level: 'HIGH', count: '3,410 атак / 24ч' },
    'us-w': { flag: '🇺🇸', title: 'США (Запад)', scam: 'Discord Nitro OAuth Token Grab', level: 'HIGH', count: '2,940 атак / 24ч' },
    'br': { flag: '🇧🇷', title: 'Бразилия (Сан-Паулу)', scam: 'Fake Skin Roulette & APK', level: 'ELEVATED', count: '1,820 атак / 24ч' },
    'de': { flag: '🇩🇪', title: 'Германия / Западная Европа', scam: 'Fake FaceIT Tournament Phish', level: 'HIGH', count: '2,150 атак / 24ч' },
    'sea': { flag: '🇵🇭', title: 'Юго-Восточная Азия', scam: 'Fake Gem Generators & Mod APK', level: 'CRITICAL', count: '3,880 атак / 24ч' },
    'tr': { flag: '🇹🇷', title: 'Турция / Ближний Восток', scam: 'Discount Currency & Gift Fraud', level: 'ELEVATED', count: '1,450 атак / 24ч' },
    'ea': { flag: '🇯🇵', title: 'Восточная Азия (JP/KR)', scam: 'Credential Stuffing Botnets', level: 'MODERATE', count: '980 атак / 24ч' },
  };

  const detailFlag = document.getElementById('detail-flag');
  const detailTitle = document.getElementById('detail-title');
  const detailScam = document.getElementById('detail-scam');
  const detailLevel = document.getElementById('detail-level');
  const detailCount = document.getElementById('detail-count');

  document.querySelectorAll<SVGElement>('.map-node-target').forEach(nodeEl => {
    const onActivate = () => {
      const id = nodeEl.getAttribute('data-node-id');
      if (id && nodeDetails[id]) {
        const d = nodeDetails[id];
        if (detailFlag) detailFlag.textContent = d.flag;
        if (detailTitle) detailTitle.textContent = d.title;
        if (detailScam) detailScam.textContent = d.scam;
        if (detailLevel) {
          detailLevel.textContent = d.level;
          detailLevel.className = `px-2.5 py-1 rounded-lg font-bold border uppercase text-[10px] ${
            d.level === 'CRITICAL' ? 'bg-red-500/20 text-red-500 border-red-500/30' :
            d.level === 'HIGH' ? 'bg-amber-500/20 text-amber-500 border-amber-500/30' :
            'bg-cyan-500/20 text-cyan-500 border-cyan-500/30'
          }`;
        }
        if (detailCount) detailCount.textContent = d.count;
      }
    };
    nodeEl.addEventListener('mouseenter', onActivate);
    nodeEl.addEventListener('click', onActivate);
  });

  // ── Dynamic Live Feed Streaming ──
  const feedContainer = document.getElementById('live-feed-ticker');
  const counterEl = document.getElementById('attacks-counter');
  let attackCount = 14892;

  const mockIncidents = [
    { from: '🇷🇺 ➔ 🇸🇪', domain: 'steamcommunity-trade-offer.link', scam: 'BitB API Phish', saved: '+$420 SAVED', color: 'red' },
    { from: '🇺🇸 ➔ 🇨🇦', domain: 'roblox-avatar-catalog-free.net', scam: '.HAR Stealer', saved: '+$1,100 SAVED', color: 'amber' },
    { from: '🇵🇭 ➔ 🇲🇾', domain: 'brawl-unlimited-gems-app.site', scam: 'Trojan APK', saved: 'BLOCKED', color: 'purple' },
    { from: '🇩🇪 ➔ 🇫🇷', domain: 'esl-major-cs2-qualifier.org', scam: 'Fake FaceIT', saved: '+$1,450 SAVED', color: 'red' },
    { from: '🇹🇷 ➔ 🇷🇺', domain: 'pubg-uc-instant-discount.top', scam: 'Carding Fraud', saved: '+$180 SAVED', color: 'amber' },
    { from: '🇺🇸 ➔ 🇩🇪', domain: 'discord-free-nitro-summer.gift', scam: 'OAuth Hijack', saved: 'BLOCKED', color: 'cyan' },
  ];

  let incidentIndex = 0;

  function pushLiveIncident() {
    if (!feedContainer) return;
    const inc = mockIncidents[incidentIndex % mockIncidents.length];
    incidentIndex++;
    attackCount++;
    if (counterEl) counterEl.textContent = attackCount.toLocaleString();

    const item = document.createElement('div');
    item.className = 'feed-item p-2.5 rounded-xl bg-ds-surface/80 border border-ds-border flex items-center justify-between gap-3 text-xs transition-all duration-300';
    item.innerHTML = `
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-base flex-shrink-0">${inc.from}</span>
        <span class="font-bold text-ds-text truncate">${inc.domain}</span>
        <span class="px-1.5 py-0.5 rounded text-[10px] bg-${inc.color}-500/20 text-${inc.color}-400 font-mono flex-shrink-0">${inc.scam}</span>
      </div>
      <div class="text-right flex-shrink-0">
        <span class="text-emerald-400 font-bold font-mono">${inc.saved}</span>
        <span class="text-[10px] text-ds-text2 block">только что</span>
      </div>
    `;

    feedContainer.prepend(item);
    if (feedContainer.children.length > 5) {
      feedContainer.removeChild(feedContainer.lastElementChild!);
    }
  }

  // UTC clock ticker
  const clockTicker = document.getElementById('live-time-ticker');
  function updateClock() {
    if (clockTicker && !document.hidden) {
      const now = new Date();
      clockTicker.textContent = now.toTimeString().split(' ')[0] + ' UTC';
    }
  }

  let incidentInterval = null;
  let clockInterval = null;

  function startTelemetry() {
    if (!incidentInterval) {
      incidentInterval = setInterval(pushLiveIncident, 4000);
    }
    if (!clockInterval) {
      updateClock();
      clockInterval = setInterval(updateClock, 1000);
    }
  }

  function stopTelemetry() {
    if (incidentInterval) {
      clearInterval(incidentInterval);
      incidentInterval = null;
    }
    if (clockInterval) {
      clearInterval(clockInterval);
      clockInterval = null;
    }
  }

  const mapStageEl = document.querySelector('.cyber-attack-map-container');
  if ('IntersectionObserver' in window && mapStageEl) {
    const mapObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !document.hidden) {
          startTelemetry();
        } else {
          stopTelemetry();
        }
      });
    }, { threshold: 0.05 });
    mapObserver.observe(mapStageEl);
  } else {
    startTelemetry();
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopTelemetry();
    } else {
      startTelemetry();
    }
  });

  // Filter Buttons
  document.querySelectorAll<HTMLButtonElement>('.map-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.map-filter-btn').forEach(b => {
        b.classList.remove('active', 'bg-ds-accent', 'text-white');
        b.classList.add('text-ds-text2');
      });
      btn.classList.add('active', 'bg-ds-accent', 'text-white');
      btn.classList.remove('text-ds-text2');
      const filter = btn.dataset.filter;
      document.querySelectorAll<SVGElement>('.map-node-target').forEach(node => {
        const game = (node.dataset.game || '').toLowerCase();
        if (filter === 'all' || game.includes(filter!)) {
          node.style.opacity = '1';
        } else {
          node.style.opacity = '0.25';
        }
      });
    });
  });

  // ── 3D Parallax Tilt Effect on Map Stage ──
  const viewport = document.getElementById('map-3d-viewport');
  const stage = viewport?.closest<HTMLElement>('.map-3d-stage');
  if (stage && viewport && !('ontouchstart' in window)) {
    stage.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = stage.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      viewport.style.transform = `rotateX(${7 - y * 8}deg) rotateY(${x * 8}deg) translateZ(4px)`;
    });
    stage.addEventListener('mouseleave', () => {
      viewport.style.transform = 'rotateX(7deg) rotateY(0deg) translateZ(0)';
    });
  }
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeIn {
    animation: fadeIn 0.3s ease-out forwards;
  }

  /* 3D Map Perspective */
  .map-3d-stage {
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  .map-3d-viewport {
    transform: rotateX(7deg);
    transform-style: preserve-3d;
    box-shadow: 0 20px 50px -10px rgba(0,0,0,0.45);
  }

  /* Radar Sweep Animation */
  @keyframes radarSweep {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .radar-sweep-beam {
    transform-origin: 500px 250px;
    animation: radarSweep 9s linear infinite;
    will-change: transform;
  }

  @media (max-width: 768px) {
    .map-3d-stage {
      perspective: none !important;
    }
    .map-3d-viewport {
      transform: none !important;
      box-shadow: 0 8px 24px -6px rgba(0,0,0,0.3) !important;
    }
    .radar-sweep-beam {
      display: none !important;
    }
  }

  /* Canvas Ocean styling in Dark vs Light */
  .cyber-map-canvas {
    background: linear-gradient(180deg, #0A1128 0%, #060A1A 100%);
    border: 1px solid rgba(108, 140, 255, 0.25);
  }
  :global(html.light) .cyber-map-canvas,
  :global(html:not(.dark)) .cyber-map-canvas {
    background: linear-gradient(180deg, #EEF4FA 0%, #E2E8F0 100%);
    border: 1px solid #CBD5E1;
    box-shadow: 0 16px 40px -10px rgba(15, 23, 42, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  /* Grid Lines */
  .map-grid-line {
    stroke: rgba(72, 214, 232, 0.12);
  }
  :global(html.light) .map-grid-line,
  :global(html:not(.dark)) .map-grid-line {
    stroke: rgba(15, 23, 42, 0.15);
  }

  /* Continents 3D Elevation & Lighting */
  .continents-3d-shadow path {
    fill: #050814;
    opacity: 0.9;
  }
  :global(html.light) .continents-3d-shadow path,
  :global(html:not(.dark)) .continents-3d-shadow path {
    fill: #94A3B8;
    opacity: 0.85;
  }

  .continents-surface path {
    fill: #111A3E;
    stroke: rgba(108, 140, 255, 0.4);
    stroke-width: 0.8;
    transition: fill 0.3s ease, stroke 0.3s ease;
  }
  :global(html.light) .continents-surface path,
  :global(html:not(.dark)) .continents-surface path {
    fill: #FFFFFF;
    stroke: #334155;
    stroke-width: 1.2;
  }

  .continents-coastline path {
    fill: none;
    stroke: #48D6E8;
    stroke-width: 1.2;
    transition: stroke 0.3s ease;
  }
  :global(html.light) .continents-coastline path,
  :global(html:not(.dark)) .continents-coastline path {
    stroke: #1E293B;
    stroke-width: 1.5;
  }

  /* Tooltip Box & Text */
  .tooltip-box {
    fill: #111936;
  }
  :global(html.light) .tooltip-box,
  :global(html:not(.dark)) .tooltip-box {
    fill: #FFFFFF;
  }

  .tooltip-text-main {
    fill: #FFFFFF;
  }
  :global(html.light) .tooltip-text-main,
  :global(html:not(.dark)) .tooltip-text-main {
    fill: #090E1E;
  }

  .tooltip-text-sub {
    fill: #48D6E8;
  }
  :global(html.light) .tooltip-text-sub,
  :global(html:not(.dark)) .tooltip-text-sub {
    fill: #0284C7;
  }
</style>
