---
import GameArtwork from './GameArtwork.astro';
import type { GameSecurityProfile } from '../data/games';
import { useTranslations } from '../i18n/ui';

interface Props {
  game: GameSecurityProfile;
  currentLang: 'en' | 'ru';
}

const { game, currentLang } = Astro.props;
const t = useTranslations(currentLang);

const badgeColors = {
  orange: 'border-orange-500/40 bg-orange-500/10 text-orange-600 dark:text-orange',
  cyan: 'border-cyan-500/40 bg-cyan-500/10 text-cyan-700 dark:text-cyan',
  violet: 'border-violet-500/40 bg-violet-500/10 text-violet-700 dark:text-violet',
  lime: 'border-lime-500/40 bg-lime-500/10 text-lime-700 dark:text-lime',
  red: 'border-red-500/40 bg-red-500/10 text-red-600 dark:text-red-400',
}[game.riskColor] || 'border-cyan-500/40 bg-cyan-500/10 text-cyan';
---

<div class="tilt-card-container">
  <article
    class="tilt-card group relative flex flex-col justify-between h-full rounded-2xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 p-6 sm:p-7 shadow-sm hover:shadow-xl dark:shadow-glow-card transition-all duration-300 hover:border-cyan/60 dark:hover:border-cyan/50"
    data-tilt-card
  >
    <!-- Background Ambient Glow on Hover -->
    <div
      class="absolute -inset-px rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none blur-sm"
      style={`background: radial-gradient(circle at top right, ${game.colorTheme.bgGlow}, transparent 70%);`}
    ></div>

    <div class="relative z-10">
      <!-- Top Row: Icon + Platforms -->
      <div class="flex items-start justify-between gap-4 mb-4">
        <div class="p-2.5 rounded-2xl bg-slate-100 dark:bg-navy-900 border border-slate-200 dark:border-navy-700 group-hover:scale-105 transition-transform duration-300">
          <GameArtwork type={game.svgArtwork as any} size="md" />
        </div>
        <div class="flex flex-col items-end gap-1.5">
          <span class={`inline-block px-2.5 py-1 rounded-full text-[11px] font-bold border uppercase tracking-wide text-right ${badgeColors}`}>
            {game.riskBadge}
          </span>
          <div class="flex flex-wrap gap-1 justify-end">
            {game.platforms.map((p) => (
              <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-cloud-subtle border border-slate-200 dark:border-navy-700">
                {p}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Title & Subtitle -->
      <h3 class="text-xl font-heading font-extrabold text-slate-900 dark:text-cloud group-hover:text-cyan-dark dark:group-hover:text-cyan transition-colors mb-1">
        <a href={`/${currentLang}/games/${game.slug}/`} class="focus:outline-none">
          {game.title}
        </a>
      </h3>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-violet mb-3">
        {game.genre}
      </p>

      <!-- Description -->
      <p class="text-xs sm:text-sm text-slate-600 dark:text-cloud-muted leading-relaxed mb-5">
        {game.cardDescription}
      </p>

      <!-- Risk Tags -->
      <div class="mb-6">
        <span class="block text-[10px] uppercase font-bold tracking-wider text-slate-500 dark:text-cloud-subtle mb-2">
          {currentLang === 'en' ? 'Documented Attack Vectors:' : 'Частые сценарии атак:'}
        </span>
        <div class="flex flex-wrap gap-1.5">
          {game.commonRiskTags.map((tag) => (
            <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-navy-900 text-slate-700 dark:text-cloud-muted border border-slate-200 dark:border-navy-700/80">
              • {tag}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Action CTA -->
    <div class="relative z-10 pt-4 border-t border-slate-200 dark:border-navy-800 flex items-center justify-between">
      <span class="text-xs text-slate-500 dark:text-cloud-subtle font-medium">
        {currentLang === 'en' ? 'Verified Defense Guide' : 'Руководство по защите'}
      </span>
      <a
        href={`/${currentLang}/games/${game.slug}/`}
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-heading font-bold text-navy-950 bg-cyan hover:bg-cyan-light transition-all shadow-sm hover:scale-105"
      >
        <span>{t('games.explore')}</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </article>
</div>

<script>
  function setupTiltCards() {
    // Only enable 3D tilt on devices that support hover (desktops/laptops) and when reduced motion is not requested
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (prefersReducedMotion || !canHover) return;

    const cards = document.querySelectorAll('[data-tilt-card]');

    cards.forEach((cardEl) => {
      const card = cardEl as HTMLElement;

      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -6; // Max 6deg
        const rotateY = ((x - centerX) / centerX) * 6;

        card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    });
  }

  setupTiltCards();
  document.addEventListener('astro:page-load', setupTiltCards);
</script>
