---
interface Props {
  variant?: 'header' | 'footer' | 'card';
}

const { variant = 'footer' } = Astro.props;

const socials = [
  {
    name: 'Telegram',
    handle: '@SafeInGame',
    url: 'https://t.me/SafeInGame',
    color: 'hover:text-[#229ED9] hover:border-[#229ED9]/50',
    icon: `<path d="M21.5 3.5L2.5 10.8C1.2 11.3 1.2 12.1 2.3 12.4L7.2 14L18.5 6.8C19 6.5 19.5 6.7 19.1 7.1L10 15.3H9.9L9.6 19.7C10.2 19.7 10.5 19.4 10.8 19.1L13.7 16.3L18.8 20.1C19.8 20.6 20.4 20.4 20.7 19.3L23.4 5.2C23.7 3.8 22.8 3.1 21.5 3.5Z"/>`,
  },
  {
    name: 'X (Twitter)',
    handle: '@SafeInGame',
    url: 'https://x.com/SafeInGame',
    color: 'hover:text-cyan-dark dark:hover:text-cyan hover:border-cyan/50',
    icon: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
  },
  {
    name: 'Instagram',
    handle: '@SafeInGame',
    url: 'https://instagram.com/SafeInGame',
    color: 'hover:text-[#E4405F] hover:border-[#E4405F]/50',
    icon: `<rect x="2" y="2" width="20" height="20" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" fill="none" stroke="currentColor" stroke-width="2"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  },
  {
    name: 'TikTok',
    handle: '@SafeInGame',
    url: 'https://tiktok.com/@SafeInGame',
    color: 'hover:text-lime-700 dark:hover:text-lime hover:border-lime/50',
    icon: `<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5v3a8 8 0 0 1-5-1.8V16a8 8 0 1 1-8-8c.7 0 1.4.1 2 .3V12z"/>`,
  },
];
---

<div class={`flex items-center gap-3 ${variant === 'card' ? 'flex-wrap' : ''}`}>
  {socials.map((item) => (
    <a
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${item.name} (${item.handle})`}
      title={`${item.name}: ${item.handle}`}
      class={`flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-navy-700 bg-slate-100 dark:bg-navy-850/80 text-slate-700 dark:text-cloud-muted transition-all duration-200 ${item.color} hover:bg-slate-200 dark:hover:bg-navy-800 hover:scale-105 shadow-sm`}
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" set:html={item.icon} />
      {variant !== 'header' && (
        <span class="text-xs font-semibold text-slate-800 dark:text-cloud">{item.name}</span>
      )}
    </a>
  ))}
</div>
