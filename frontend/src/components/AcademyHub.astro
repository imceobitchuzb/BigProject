---
import SafiMascot from './SafiMascot.astro';

interface Props {
  currentLang?: 'en' | 'ru' | 'uz';
}

const { currentLang = 'en' } = Astro.props;
const isRu = currentLang === 'ru';

const tracks = [
  {
    id: 'rookie',
    level: 1,
    title: isRu ? 'Курс 1: Новобранец киберзащиты' : 'Track 1: Rookie Defender',
    badge: isRu ? 'Базовый' : 'Beginner',
    badgeColor: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
    desc: isRu
      ? 'Основы цифровой гигиены: двухфакторная аутентификация, надежные пароли и выявление фальшивых раздач.'
      : 'Core digital hygiene: app-based 2FA, unique passphrases, and spotting fake giveaway campaigns.',
    xp: 250,
    modules: [
      { id: 'm1', title: isRu ? '1. Анатомия надежного игрового пароля' : '1. Anatomy of a Resilient Password' },
      { id: 'm2', title: isRu ? '2. Почему SMS-коды уязвимы и как включить Authenticator' : '2. Why SMS 2FA is Vulnerable & App Setup' },
      { id: 'm3', title: isRu ? '3. Иллюзия бесплатного сыра: разбор фейковых раздач' : '3. The Free Loot Illusion: Fake Giveaways' },
    ],
  },
  {
    id: 'guardian',
    level: 2,
    title: isRu ? 'Курс 2: Хранитель инвентаря' : 'Track 2: Inventory Guardian',
    badge: isRu ? 'Средний' : 'Intermediate',
    badgeColor: 'bg-cyan-500/10 text-cyan border-cyan-500/30',
    desc: isRu
      ? 'Защита виртуальных предметов: перехват API ключей, кража куки .ROBLOSECURITY и фишинг под видом турниров.'
      : 'Virtual asset defense: Steam Web API key hijacking, Roblox cookie theft, and tournament phish.',
    xp: 450,
    modules: [
      { id: 'm4', title: isRu ? '4. Как работает подмена трейдов в Steam (MitM)' : '4. How Steam Trade Interception Works (MitM)' },
      { id: 'm5', title: isRu ? '5. Опасность консоли F12 и кража сессионных токенов' : '5. DevTools F12 Risks & Session Cookie Theft' },
      { id: 'm6', title: isRu ? '6. Фальшивые турниры и голосования за команду' : '6. Forged Tournament Portals & OpenID Phishing' },
    ],
  },
  {
    id: 'sentinel',
    level: 3,
    title: isRu ? 'Курс 3: Кибер-страж' : 'Track 3: Cyber Sentinel',
    badge: isRu ? 'Продвинутый' : 'Advanced',
    badgeColor: 'bg-purple-500/10 text-purple-400 border-purple-500/30',
    desc: isRu
      ? 'Психология социальной инженерии, анализ вредоносных модов, триаж инцидента и аварийное восстановление.'
      : 'Psychological manipulation, malicious mod analysis, incident containment, and forensic rescue.',
    xp: 600,
    modules: [
      { id: 'm7', title: isRu ? '7. Психология манипуляции: страх бана и спешка' : '7. Social Engineering: Fear, Urgency & Trust' },
      { id: 'm8', title: isRu ? '8. Вредоносные моды Minecraft и читы со стилерами' : '8. Trojan Game Mods & Infostealers in JAR/EXEs' },
      { id: 'm9', title: isRu ? '9. Первые 15 минут после взлома: протокол триажа' : '9. First 15 Minutes Post-Compromise: Triage Protocol' },
    ],
  },
];
---

<div class="max-w-6xl mx-auto px-4 py-8">
  <!-- Hero Card -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-navy-900 to-slate-950 border border-cyan/20 p-6 sm:p-10 mb-10 shadow-2xl">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-4 text-center md:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan text-xs font-semibold">
          <svg class="w-4 h-4 text-cyan" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a10.99 10.99 0 014.75 3.949 10.99 10.99 0 014.75-3.949l2.644-1.13a1 1 0 000-1.84l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.76zM15 10.12l1.69-.723a11.115 11.115 0 01.25 3.76 1 1 0 01-.89.89 8.969 8.969 0 00-1.05.174V10.12zm-3.5 2.88a9.01 9.01 0 00-3 0v4.218a10.96 10.96 0 013-1.066V13z"/>
          </svg>
          <span>{isRu ? 'Академия SafeInGame' : 'SafeInGame Cyber Academy'}</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          {isRu ? 'Стань неуязвимым в онлайн-играх' : 'Level Up Your Gaming Cyber Defense'}
        </h1>
        <p class="text-slate-400 text-sm sm:text-base max-w-2xl leading-relaxed">
          {isRu
            ? 'Пошаговые интерактивные треки от базовой гигиены до глубокого понимания социальной инженерии и защиты инвентаря. Зарабатывайте XP и получите именной сертификат.'
            : 'Interactive training tracks from fundamental credential defense to advanced social engineering neutralization. Earn XP and verify your mastery.'}
        </p>

        <!-- Player XP Progress Bar -->
        <div class="pt-2 max-w-md">
          <div class="flex items-center justify-between text-xs font-bold text-slate-300 mb-1.5">
            <span>{isRu ? 'Прогресс Академии:' : 'Academy Progress:'}</span>
            <span id="player-xp" class="text-cyan font-black">0 / 1300 XP</span>
          </div>
          <div class="w-full h-3 rounded-full bg-navy-950 border border-slate-700 overflow-hidden">
            <div id="player-xp-bar" class="h-full bg-gradient-to-r from-cyan-500 to-emerald-400 w-0 transition-all duration-500"></div>
          </div>
        </div>
      </div>

      <div class="shrink-0 flex flex-col items-center">
        <SafiMascot mood="guard" size="xl" />
        <span class="text-xs font-bold text-cyan mt-3">SAFI Chief Instructor</span>
      </div>
    </div>
  </div>

  <!-- Tracks Section -->
  <div class="space-y-8 mb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {tracks.map((track) => (
        <div class="rounded-3xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 p-6 flex flex-col justify-between shadow-sm hover:border-cyan/40 transition">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class={`text-[11px] font-black uppercase px-2.5 py-1 rounded-full border ${track.badgeColor}`}>
                {track.badge}
              </span>
              <span class="text-xs font-bold text-cyan">+{track.xp} XP</span>
            </div>

            <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
              {track.title}
            </h2>
            <p class="text-xs text-slate-600 dark:text-cloud-muted mb-4 leading-relaxed">
              {track.desc}
            </p>

            <div class="space-y-2 mb-6">
              {track.modules.map((m) => (
                <label class="flex items-center gap-2.5 p-2 rounded-xl bg-slate-50 dark:bg-navy-950 border border-slate-200 dark:border-navy-800 text-xs text-slate-700 dark:text-slate-300 cursor-pointer hover:bg-slate-100 dark:hover:bg-navy-800 transition">
                  <input
                    type="checkbox"
                    class="module-check w-4 h-4 rounded text-cyan focus:ring-cyan"
                    data-module={m.id}
                    data-xp={track.xp / 3}
                  />
                  <span class="line-clamp-1">{m.title}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="pt-3 border-t border-slate-200 dark:border-navy-800 flex items-center justify-between">
            <span class="text-[11px] text-slate-400">Status: <span class="track-status font-semibold text-amber-500">In Progress</span></span>
            <span class="text-xs font-bold text-cyan">Track {track.level}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Certification Section -->
  <div id="cert-section" class="rounded-3xl bg-slate-900 border border-cyan/30 p-6 sm:p-10 text-center space-y-6">
    <div class="max-w-2xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
        <span>{isRu ? 'Официальный образовательный сертификат' : 'Educational Completion Certificate'}</span>
      </div>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
        {isRu ? 'Сертификат SafeInGame Defender' : 'SafeInGame Defender Certificate'}
      </h3>
      <p class="text-slate-400 text-sm">
        {isRu
          ? 'Завершите все 9 модулей Академии, чтобы разблокировать персональный сертификат и верификационный знак для игрового профиля.'
          : 'Complete all 9 Academy modules to generate your personalized certificate and digital badge.'}
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
        <input
          type="text"
          id="student-name"
          placeholder={isRu ? 'Введите ваше игровое имя или ник...' : 'Enter your gamer tag or name...'}
          class="px-4 py-3 rounded-xl bg-navy-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan text-sm w-full sm:w-72"
        />
        <button
          type="button"
          id="generate-cert-btn"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-cyan-gradient text-navy-950 font-bold hover:shadow-lg hover:shadow-cyan/20 transition"
        >
          {isRu ? 'Сгенерировать сертификат' : 'Generate Certificate'}
        </button>
      </div>

      <!-- Legal Educational Disclaimer -->
      <p class="text-[11px] text-slate-500 pt-3">
        * {isRu
          ? 'Сертификат Академии SafeInGame подтверждает прохождение базового курса игровой кибергигиены. Он не является официальной государственной или аккредитованной профессиональной лицензией в области информационной безопасности.'
          : 'The SafeInGame Academy Certificate verifies completion of digital awareness training. It is an educational recognition and does not constitute an accredited professional cybersecurity license.'}
      </p>
    </div>

    <!-- Certificate Render Modal / Area -->
    <div id="cert-canvas-container" class="hidden max-w-2xl mx-auto p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-950 via-navy-900 to-slate-900 border-2 border-cyan text-left shadow-2xl relative">
      <div class="flex items-center justify-between border-b border-cyan/20 pb-4 mb-4">
        <div>
          <div class="text-[10px] tracking-widest uppercase font-extrabold text-cyan">SafeInGame Cybersecurity Academy</div>
          <div class="text-xl font-black text-white">CERTIFICATE OF COMPLETION</div>
        </div>
        <SafiMascot mood="celebrate" size="sm" />
      </div>

      <p class="text-xs text-slate-400 mb-2">This is to certify that:</p>
      <div id="cert-recipient" class="text-2xl font-black text-cyan mb-3">CyberPlayer_2026</div>
      <p class="text-xs text-slate-300 leading-relaxed mb-6">
        Has successfully demonstrated practical proficiency in digital gaming asset defense, phishing detection, session token security, and social engineering counter-measures across supported platforms.
      </p>

      <div class="flex items-center justify-between text-[10px] text-slate-400 border-t border-slate-800 pt-3">
        <div>Verification ID: <span class="font-mono text-cyan">SIG-ACAD-2026</span></div>
        <div>Status: <span class="text-emerald-400 font-bold">VERIFIED</span></div>
      </div>
    </div>
  </div>
</div>

<script>
  const checkboxes = document.querySelectorAll('.module-check') as NodeListOf<HTMLInputElement>;
  const xpText = document.getElementById('player-xp');
  const xpBar = document.getElementById('player-xp-bar');
  const studentInput = document.getElementById('student-name') as HTMLInputElement;
  const generateBtn = document.getElementById('generate-cert-btn');
  const certContainer = document.getElementById('cert-canvas-container');
  const certRecipient = document.getElementById('cert-recipient');

  const STORAGE_KEY = 'safeingame_academy_modules';

  function loadProgress() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      let totalXp = 0;
      checkboxes.forEach((cb) => {
        if (saved.includes(cb.dataset.module)) {
          cb.checked = true;
          totalXp += parseFloat(cb.dataset.xp || '0');
        }
      });
      updateXp(Math.round(totalXp));
    } catch (e) {
      // storage unavailable
    }
  }

  function saveProgress() {
    const checkedModules: string[] = [];
    let totalXp = 0;
    checkboxes.forEach((cb) => {
      if (cb.checked && cb.dataset.module) {
        checkedModules.push(cb.dataset.module);
        totalXp += parseFloat(cb.dataset.xp || '0');
      }
    });
    localStorage.setItem(STORAGE_KEY, JSON.stringify(checkedModules));
    updateXp(Math.round(totalXp));
  }

  function updateXp(xp: number) {
    if (xpText) xpText.textContent = `${xp} / 1300 XP`;
    if (xpBar) {
      const pct = Math.min(100, Math.round((xp / 1300) * 100));
      xpBar.style.width = `${pct}%`;
    }
  }

  checkboxes.forEach((cb) => {
    cb.addEventListener('change', saveProgress);
  });

  generateBtn?.addEventListener('click', () => {
    const name = studentInput?.value.trim() || 'Gamer_Sentinel';
    if (certRecipient) certRecipient.textContent = name;
    certContainer?.classList.remove('hidden');
    certContainer?.scrollIntoView({ behavior: 'smooth' });
  });

  loadProgress();
</script>
