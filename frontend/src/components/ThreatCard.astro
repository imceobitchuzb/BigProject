---
interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  categoryTitle: string;
  readingTime: string;
  warningSignsCount: number;
  currentLang: 'en' | 'ru';
}

const {
  slug,
  title,
  description,
  category,
  categoryTitle,
  readingTime,
  warningSignsCount,
  currentLang,
} = Astro.props;

// Category badge color
const categoryColors: Record<string, string> = {
  'account-security': 'text-cyan-700 dark:text-cyan border-cyan-500/30 bg-cyan-500/10',
  'phishing': 'text-orange-600 dark:text-orange border-orange-500/30 bg-orange-500/10',
  'trading-and-items': 'text-violet-700 dark:text-violet border-violet-500/30 bg-violet-500/10',
  'currency-and-payments': 'text-lime-700 dark:text-lime border-lime-500/30 bg-lime-500/10',
  'fake-giveaways': 'text-orange-600 dark:text-orange border-orange-500/30 bg-orange-500/10',
  'fake-support': 'text-cyan-700 dark:text-cyan border-cyan-500/30 bg-cyan-500/10',
  'social-engineering': 'text-violet-700 dark:text-violet border-violet-500/30 bg-violet-500/10',
  'incident-response': 'text-red-600 dark:text-red-400 border-red-500/30 bg-red-500/10',
};

const badgeStyle = categoryColors[category] || 'text-cyan-700 dark:text-cyan border-cyan-500/30 bg-cyan-500/10';
---

<article class="group relative flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 p-6 shadow-sm hover:shadow-lg dark:hover:shadow-glow-cyan transition-all duration-300 hover:-translate-y-1 hover:border-cyan-500/50 dark:hover:border-cyan/50">
  <div>
    <!-- Header Meta -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold border ${badgeStyle}`}>
        {categoryTitle}
      </span>
      <span class="text-xs text-slate-500 dark:text-cloud-subtle font-medium">
        {readingTime}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-lg font-heading font-bold text-slate-900 dark:text-cloud group-hover:text-cyan-dark dark:group-hover:text-cyan transition-colors mb-2">
      <a href={`/${currentLang}/threats/${slug}`}>
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm text-slate-600 dark:text-cloud-muted leading-relaxed line-clamp-3 mb-6">
      {description}
    </p>
  </div>

  <!-- Bottom Action / Warning Badge -->
  <div class="pt-4 border-t border-slate-100 dark:border-navy-800 flex items-center justify-between">
    <div class="flex items-center gap-1.5 text-xs text-orange-600 dark:text-orange font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span>
        {warningSignsCount} {currentLang === 'en' ? 'warning signs' : 'признака опасности'}
      </span>
    </div>

    <a
      href={`/${currentLang}/threats/${slug}`}
      class="text-xs font-semibold text-cyan-dark dark:text-cyan inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform"
      aria-label={`Read guide: ${title}`}
    >
      <span>{currentLang === 'en' ? 'Read Guide' : 'Читать'}</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
