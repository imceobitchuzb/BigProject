---
interface Props {
  type: 'cs2' | 'brawlstars' | 'pubg' | 'roblox' | 'minecraft';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { type, size = 'md', class: extraClass = '' } = Astro.props;

const dimensions = {
  sm: 'w-10 h-10',
  md: 'w-16 h-16 sm:w-20 sm:h-20',
  lg: 'w-24 h-24 sm:w-28 sm:h-28',
  xl: 'w-32 h-32 sm:w-36 sm:h-36',
}[size];

const fileMap: Record<string, string> = {
  cs2: 'cs2-steam.jpg',
  brawlstars: 'brawl-stars.jpg',
  pubg: 'pubg.jpg',
  roblox: 'roblox.webp',
  minecraft: 'minecraft.webp',
};

const altMap: Record<string, string> = {
  cs2: 'Counter-Strike 2 & Steam',
  brawlstars: 'Brawl Stars',
  pubg: 'PUBG Battlegrounds',
  roblox: 'Roblox',
  minecraft: 'Minecraft',
};

const fileName = fileMap[type] || 'cs2-steam.jpg';
const altText = altMap[type] || 'Game Security Profile';
---

<div
  class={`relative ${dimensions} aspect-square flex-shrink-0 select-none overflow-hidden rounded-2xl border border-slate-200/90 dark:border-navy-700 bg-slate-100 dark:bg-navy-900 shadow-sm group-hover:shadow-md transition-all duration-300 ${extraClass}`}
>
  <img
    src={`/images/games/${fileName}`}
    alt={`${altText} Icon`}
    class="w-full h-full object-cover object-center transition-transform duration-300 group-hover:scale-105"
    width="160"
    height="160"
    loading="lazy"
  />
</div>
