---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  currentLang: 'en' | 'ru' | 'uz';
}

const { currentLang = 'en' } = Astro.props;
const t = useTranslations(currentLang as any);
const pathname = Astro.url.pathname;

const navPillars = [
  {
    key: 'protect',
    label: t('nav.protect'),
    items: [
      { href: `/${currentLang}/scanner/`, label: t('nav.scanner'), desc: 'Real-time phishing & typosquatting detection' },
      { href: `/${currentLang}/detective/`, label: t('nav.detective'), desc: 'Analyze suspicious messages & screenshots', badge: 'AI' },
      { href: `/${currentLang}/recovery/`, label: t('nav.recovery'), desc: 'Step-by-step account recovery wizard', badge: 'SOS', isSos: true },
      { href: `/${currentLang}/guardian/`, label: t('nav.guardian'), desc: 'Chromium browser protection extension' },
    ],
  },
  {
    key: 'learn',
    label: t('nav.learn'),
    items: [
      { href: `/${currentLang}/academy/`, label: t('nav.academy'), desc: 'Security tracks, XP and completion certificate', badge: 'NEW' },
      { href: `/${currentLang}/simulator/`, label: t('nav.simulator'), desc: '10 interactive realistic scam simulations' },
      { href: `/${currentLang}/games/`, label: t('nav.games'), desc: 'CS2, Roblox, Brawl Stars, Minecraft, PUBG' },
      { href: `/${currentLang}/threats/`, label: t('nav.threats'), desc: 'In-depth educational security articles' },
    ],
  },
  {
    key: 'family',
    label: t('nav.family'),
    items: [
      { href: `/${currentLang}/parents/`, label: t('nav.parents'), desc: 'Parental controls & non-invasive child guidance', badge: 'FAMILY' },
    ],
  },
  {
    key: 'intelligence',
    label: t('nav.intelligence'),
    items: [
      { href: `/${currentLang}/threats/database/`, label: t('nav.threat_db'), desc: 'Verified IOCs, attack vectors and advisories' },
      { href: `/${currentLang}/radar/`, label: t('nav.radar'), desc: 'Live global threat campaigns across games' },
      { href: `/${currentLang}/report/`, label: t('nav.report'), desc: 'Submit scam links & Discord fraud to our queue' },
    ],
  },
  {
    key: 'community',
    label: t('nav.community'),
    items: [
      { href: `/${currentLang}/score/`, label: t('nav.score'), desc: 'Assess your gamer security hygiene (0-100)', badge: 'CHECK' },
      { href: `/${currentLang}/about/`, label: t('nav.about'), desc: 'Our mission, principles & transparency' },
      { href: `/${currentLang}/contact/`, label: t('nav.contact'), desc: 'Direct feedback & engineering contacts' },
    ],
  },
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-navy-800 bg-white/95 dark:bg-navy-900/95 backdrop-blur-md transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href={`/${currentLang}/`} class="flex items-center gap-2 group" aria-label={t('nav.home')}>
      <Logo size="md" currentLang={currentLang} />
    </a>

    <!-- Desktop Navigation Pillars with Dropdowns -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
      {navPillars.map((pillar) => {
        const isPillarActive = pillar.items.some(item => pathname.startsWith(item.href));
        return (
          <div class="relative group">
            <button
              type="button"
              class={`px-3 py-2 text-sm font-semibold rounded-lg flex items-center gap-1.5 transition-all duration-150 ${
                isPillarActive
                  ? 'text-cyan-dark dark:text-cyan bg-cyan-500/10'
                  : 'text-slate-700 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan hover:bg-slate-100 dark:hover:bg-navy-800'
              }`}
              aria-haspopup="true"
            >
              <span>{pillar.label}</span>
              <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div class="absolute left-0 mt-1 w-72 rounded-2xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 shadow-2xl shadow-cyan/5 p-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              {pillar.items.map((item) => (
                <a
                  href={item.href}
                  class="flex flex-col p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-navy-800/80 transition-colors group/item"
                >
                  <div class="flex items-center justify-between">
                    <span class={`text-sm font-medium ${item.isSos ? 'text-red-600 dark:text-red-400 font-bold' : 'text-slate-900 dark:text-cloud group-hover/item:text-cyan-dark dark:group-hover/item:text-cyan'}`}>
                      {item.label}
                    </span>
                    {item.badge && (
                      <span class={`text-[10px] font-extrabold px-1.5 py-0.5 rounded uppercase ${
                        item.isSos
                          ? 'bg-red-500/15 text-red-600 dark:text-red-400 border border-red-500/30 animate-pulse'
                          : 'bg-cyan-500/15 text-cyan-dark dark:text-cyan'
                      }`}>
                        {item.badge}
                      </span>
                    )}
                  </div>
                  <span class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 line-clamp-1">
                    {item.desc}
                  </span>
                </a>
              ))}
            </div>
          </div>
        );
      })}

      <!-- Quick Action: SOS / Recovery Link -->
      <a
        href={`/${currentLang}/recovery/`}
        class="ml-2 px-3 py-1.5 text-xs font-bold text-red-600 dark:text-red-400 bg-red-500/10 border border-red-500/20 rounded-lg hover:bg-red-500/20 transition-colors flex items-center gap-1.5"
      >
        <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
        <span>SOS Rescue</span>
      </a>
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-2.5">
      <ThemeToggle currentLang={currentLang as any} />
      <LanguageSwitcher currentLang={currentLang as any} />

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-xl text-slate-600 dark:text-cloud-muted hover:text-slate-900 dark:hover:text-cloud bg-slate-100 dark:bg-navy-800 border border-slate-200 dark:border-navy-700 focus:outline-none focus:ring-2 focus:ring-cyan"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Toggle navigation menu</span>
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 dark:border-navy-800 bg-white/95 dark:bg-navy-900/95 backdrop-blur-md px-4 py-4 max-h-[85vh] overflow-y-auto">
    <div class="space-y-4">
      {navPillars.map((pillar) => (
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 px-2 mb-1.5">
            {pillar.label}
          </div>
          <div class="space-y-1">
            {pillar.items.map((item) => (
              <a
                href={item.href}
                class="flex items-center justify-between px-3 py-2 rounded-xl text-sm font-medium hover:bg-slate-100 dark:hover:bg-navy-800 text-slate-800 dark:text-cloud"
              >
                <span>{item.label}</span>
                {item.badge && (
                  <span class={`text-[10px] font-extrabold px-1.5 py-0.5 rounded uppercase ${
                    item.isSos ? 'bg-red-500/20 text-red-600 dark:text-red-400' : 'bg-cyan-500/20 text-cyan-dark dark:text-cyan'
                  }`}>
                    {item.badge}
                  </span>
                )}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
