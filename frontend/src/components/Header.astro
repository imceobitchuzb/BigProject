---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  currentLang: 'en' | 'ru';
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const pathname = Astro.url.pathname;

const navItems = [
  { href: `/${currentLang}/scanner/`, label: t('nav.scanner') },
  { href: `/${currentLang}/lab/`, label: t('nav.lab'), badge: 'LAB' },
  { href: `/${currentLang}/recovery/`, label: t('nav.recovery'), badge: 'SOS', isSos: true },
  { href: `/${currentLang}/games/`, label: t('nav.games') },
  { href: `/${currentLang}/safety/`, label: t('nav.safety') },
  { href: `/${currentLang}/threats/`, label: t('nav.threats') },
  { href: `/${currentLang}/about/`, label: t('nav.about') },
  { href: `/${currentLang}/contact/`, label: t('nav.contact') },
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-navy-800 bg-white/95 dark:bg-navy-900/95 backdrop-blur-md transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logo (Takes users to Home) -->
    <a href={`/${currentLang}/`} class="flex items-center" aria-label={t('nav.home')} title={t('nav.home')}>
      <Logo size="md" currentLang={currentLang} />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-4 xl:gap-5" aria-label="Main Navigation">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== `/${currentLang}/` && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors hover:text-cyan flex items-center gap-1.5 ${
              isActive
                ? 'text-cyan-dark dark:text-cyan font-semibold border-b-2 border-cyan pb-1'
                : item.isSos
                  ? 'text-red-600 dark:text-red-400 font-bold hover:text-red-700 dark:hover:text-red-300'
                  : 'text-slate-600 dark:text-cloud-muted hover:text-cyan-dark dark:hover:text-cyan'
            }`}
          >
            <span>{item.label}</span>
            {item.badge && (
              <span class={`text-[10px] font-extrabold uppercase px-1.5 py-0.2 rounded ${
                item.isSos
                  ? 'bg-red-500/15 text-red-600 dark:text-red-400 border border-red-500/30 animate-pulse'
                  : 'bg-cyan-500/15 text-cyan-dark dark:text-cyan'
              }`}>
                {item.badge}
              </span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <ThemeToggle currentLang={currentLang} />
      <LanguageSwitcher currentLang={currentLang} />

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-xl text-slate-600 dark:text-cloud-muted hover:text-slate-900 dark:hover:text-cloud bg-slate-100 dark:bg-navy-800 border border-slate-200 dark:border-navy-700 focus:outline-none focus:ring-2 focus:ring-cyan"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle Navigation Menu"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-slate-200 dark:border-navy-800 bg-white dark:bg-navy-850 px-4 pt-2 pb-4 space-y-1 shadow-lg">
    {navItems.map((item) => {
      const isActive = pathname === item.href || (item.href !== `/${currentLang}/` && pathname.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`flex items-center justify-between px-3 py-2 rounded-lg text-base font-medium ${
            isActive
              ? 'bg-slate-100 dark:bg-navy-800 text-cyan-dark dark:text-cyan font-semibold'
              : item.isSos
                ? 'text-red-600 dark:text-red-400 font-bold bg-red-500/5'
                : 'text-slate-600 dark:text-cloud-muted hover:bg-slate-100 dark:hover:bg-navy-800 hover:text-slate-900 dark:hover:text-cloud'
          }`}
        >
          <span>{item.label}</span>
          {item.badge && (
            <span class={`text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded ${
              item.isSos
                ? 'bg-red-500/15 text-red-600 dark:text-red-400 border border-red-500/30'
                : 'bg-cyan-500/15 text-cyan-dark dark:text-cyan'
            }`}>
              {item.badge}
            </span>
          )}
        </a>
      );
    })}
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (btn && menu && iconOpen && iconClose) {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!isExpanded));
        menu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      });
    }
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
