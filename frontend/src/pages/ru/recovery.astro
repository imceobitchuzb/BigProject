---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecoveryWizard from '../../components/RecoveryWizard.astro';
import CyberBackground from '../../components/CyberBackground.astro';

const title = 'Мастер восстановления аккаунта: Пошаговая инструкция после скама — SafeInGame';
const description = 'Спокойный пошаговый план действий, прямые ссылки в техподдержку, инструкции «куда нажимать» и генератор официального обращения для возврата украденного игрового профиля.';
---

<BaseLayout
  title={title}
  description={description}
  currentLang="ru"
  canonicalSlug="recovery/"
>
  <div class="relative min-h-screen py-12 lg:py-16">
    <CyberBackground />

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-cloud-subtle mb-8" aria-label="Breadcrumb">
        <a href="/ru/" class="hover:text-cyan transition-colors">Главная</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-cloud font-medium">Мастер восстановления</span>
      </nav>

      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold border border-red-500/40 bg-red-500/10 text-red-600 dark:text-red-400 uppercase tracking-wider mb-4 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          <span>Экстренная скорая помощь при скаме и взломе</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-heading font-extrabold text-slate-900 dark:text-cloud tracking-tight mb-4">
          Мастер восстановления аккаунта
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-cloud-muted leading-relaxed">
          Главное — не паниковать. Выберите игру, укажите, какие данные попали к мошенникам, и получите точные ссылки, инструкции «куда нажимать» и готовый юридически выверенный текст обращения в поддержку.
        </p>
      </div>

      <!-- Main Recovery Wizard Component -->
      <div class="mb-16">
        <RecoveryWizard currentLang="ru" />
      </div>
    </div>
  </div>
</BaseLayout>
