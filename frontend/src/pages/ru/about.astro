---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CyberBackground from '../../components/CyberBackground.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import Logo from '../../components/Logo.astro';
import { useTranslations } from '../../i18n/ui';

const currentLang = 'ru';
const t = useTranslations(currentLang);
---

<BaseLayout
  title="О проекте SafeInGame — Миссия, Принципы и Планы"
  description="Узнайте о SafeInGame — независимом образовательном проекте, посвященном безопасности игровых аккаунтов и киберграмотности."
  currentLang={currentLang}
  canonicalSlug="about/"
>
  <div class="relative overflow-hidden py-12">
    <CyberBackground variant="minimal" />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-block mb-4">
        <Logo size="lg" showText={false} />
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-slate-900 dark:text-cloud tracking-tight mb-4">
        Играй с умом. Оставайся в безопасности.
      </h1>
      <p class="text-base text-slate-600 dark:text-cloud-muted leading-relaxed">
        SafeInGame — независимый некоммерческий образовательный проект, созданный для обучения игроков кибербезопасности и защите виртуальных ценностей.
      </p>
    </div>

    <!-- The Problem Statement -->
    <section class="mb-14 rounded-2xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 p-6 sm:p-8 shadow-sm">
      <h2 class="text-xl font-heading font-bold text-cyan-700 dark:text-cyan mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-cyan-700 dark:text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Зачем был создан SafeInGame</span>
      </h2>
      <div class="space-y-4 text-sm text-slate-600 dark:text-cloud-muted leading-relaxed">
        <p>
          В 2026 году игровые аккаунты превратились в ценные цифровые активы. Миллионы геймеров вкладывают годы времени, ранги и реальные средства в развитие профилей и инвентари. Однако при столкновении с продвинутым фишингом, API-скамом или социальной инженерией игроки часто остаются один на один с проблемой.
        </p>
        <p>
          Форумы и сообщества наводнены вторичными скамерами, предлагающими платные «услуги взлома для возврата», а официальная поддержка издателей в моменты массовых атак может отвечать неделями. SafeInGame создан для того, чтобы дать игрокам превентивные знания до инцидента и четкий план сдерживания угрозы, если взлом уже произошел.
        </p>
      </div>
    </section>

    <!-- Core Principles -->
    <section class="mb-14">
      <h2 class="text-2xl font-heading font-bold text-slate-900 dark:text-cloud mb-6">
        Наши принципы
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 shadow-sm">
          <h3 class="text-base font-heading font-bold text-lime-700 dark:text-lime mb-2">
            1. Никаких паролей и данных
          </h3>
          <p class="text-xs text-slate-600 dark:text-cloud-muted leading-relaxed">
            SafeInGame никогда не запрашивает ваши пароли, коды аутентификатора, секретные фразы, резервные ключи или токены сессий.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 shadow-sm">
          <h3 class="text-base font-heading font-bold text-cyan-700 dark:text-cyan mb-2">
            2. Честное просвещение, а не хайп
          </h3>
          <p class="text-xs text-slate-600 dark:text-cloud-muted leading-relaxed">
            Мы не продаем «чудо-античиты», сканеры уязвимостей и не обещаем стопроцентной защиты. Кибербезопасность — это постоянная осознанность, а не волшебная кнопка.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 shadow-sm">
          <h3 class="text-base font-heading font-bold text-violet-700 dark:text-violet mb-2">
            3. Официальные источники
          </h3>
          <p class="text-xs text-slate-600 dark:text-cloud-muted leading-relaxed">
            Все рекомендации основаны на официальной справочной документации Valve, Epic Games, Sony, Microsoft, Riot Games, Discord и агентств по кибербезопасности.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 shadow-sm">
          <h3 class="text-base font-heading font-bold text-orange-600 dark:text-orange mb-2">
            4. Независимость и нейтральность
          </h3>
          <p class="text-xs text-slate-600 dark:text-cloud-muted leading-relaxed">
            SafeInGame не сотрудничает с сомнительными рулетками скинов, нерегулируемыми биржами ключей и платными «восстановителями».
          </p>
        </div>
      </div>
    </section>

    <!-- Current Stage & Transparent Roadmap -->
    <section class="mb-14 rounded-2xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-850 p-6 sm:p-8 shadow-sm">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-violet-500/30 bg-violet-500/10 text-violet-700 dark:text-violet text-xs font-semibold mb-4">
        Статус проекта: Фаза 1 MVP + Игровой Центр
      </div>
      <h2 class="text-2xl font-heading font-bold text-slate-900 dark:text-cloud mb-4">
        Текущий статус и прозрачные планы
      </h2>
      <p class="text-sm text-slate-600 dark:text-cloud-muted leading-relaxed mb-6">
        Проект поддерживается независимым разработчиком. Мы открыто рассказываем о текущем функционале и будущих шагах:
      </p>

      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-lime-500/20 text-lime-700 dark:text-lime font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
          <div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-cloud">Фаза 1: База знаний и Центр безопасности по играм (Работает)</h4>
            <p class="text-xs text-slate-600 dark:text-cloud-muted">8 образовательных руководств, 5 специализированных игровых страниц, темная и светлая темы, надежная форма обратной связи.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-cyan-500/20 text-cyan-700 dark:text-cyan font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">✓</span>
          <div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-cloud">Фаза 2: Интерактивный квиз и разбор скам-паттернов (Работает)</h4>
            <p class="text-xs text-slate-600 dark:text-cloud-muted">Интерактивные сценарии и обучающие тесты, помогающие безопасно тренироваться в распознавании фишинга и уловок.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-slate-200 dark:bg-navy-700 text-slate-500 dark:text-cloud-subtle font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">3</span>
          <div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-cloud">Фаза 3: Прием сообщений о новых схемах (В планах)</h4>
            <p class="text-xs text-slate-600 dark:text-cloud-muted">Структурированный сбор информации о новых методах обмана от сообщества с экспертной модерацией.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Social Channels & Contact -->
    <section class="text-center pt-8 border-t border-slate-200 dark:border-navy-800">
      <h2 class="text-xl font-heading font-bold text-slate-900 dark:text-cloud mb-3">
        Присоединяйтесь к SafeInGame
      </h2>
      <p class="text-sm text-slate-600 dark:text-cloud-muted max-w-md mx-auto mb-6">
        Подписывайтесь на наши официальные каналы для получения свежих разборов схем и рекомендаций:
      </p>
      <div class="flex justify-center mb-8">
        <SocialLinks variant="card" />
      </div>
      <div>
        <a
          href="/ru/contact/"
          class="inline-block px-6 py-3 rounded-xl bg-cyan text-navy-950 font-heading font-bold text-sm hover:bg-cyan-light transition-all shadow-glow-cyan"
        >
          Отправить отзыв или схему обмана
        </a>
      </div>
    </section>
    </div>
  </div>
</BaseLayout>
