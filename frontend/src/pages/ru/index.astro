---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScamPatterns from '../../components/ScamPatterns.astro';
import ScamQuiz from '../../components/ScamQuiz.astro';
import DashboardTelemetry from '../../components/DashboardTelemetry.astro';
import CyberAttackMap from '../../components/CyberAttackMap.astro';
import { getAllGames } from '../../data/games';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/ui';

const currentLang = 'ru';
const t = useTranslations(currentLang);

const games = getAllGames(currentLang);

const allThreats = await getCollection('threats', ({ id }) => id.startsWith('ru/'));
const sortedThreats = allThreats.sort(
  (a, b) => new Date(b.data.published_date).getTime() - new Date(a.data.published_date).getTime()
);
const featuredThreats = sortedThreats.slice(0, 3);

const featureCards = [
  { href: '/ru/scanner/',   title: 'Сканер ссылок',        description: 'Обнаружение гомоглифов, тайпсквотинга и фишинговых URL в реальном времени.', icon: 'scanner', color: 'cyan',   badge: 'Live', statusOk: true, status: 'Online' },
  { href: '/ru/detective/', title: 'ИИ-детектив мошенств', description: 'Анализ подозрительных сообщений и скриншотов на скрытые векторы атак.',       icon: 'ai',      color: 'violet', badge: 'ИИ',   statusOk: true, status: 'Активен' },
  { href: '/ru/score/',     title: 'Оценка безопасности',  description: 'Оцените уровень защиты ваших игровых аккаунтов по 12 параметрам.',              icon: 'score',   color: 'accent', badge: 'Проверь', statusOk: true, status: 'Готов' },
  { href: '/ru/radar/',     title: 'Радар угроз',          description: 'Глобальный трекер активных мошеннических кампаний и фишинговых волн.',            icon: 'radar',   color: 'orange', badge: 'Intel', statusOk: true, status: 'Мониторинг' },
  { href: '/ru/simulator/', title: 'Симулятор мошенств',   description: '10 интерактивных сценариев для тренировки ваших защитных инстинктов.',           icon: 'sim',     color: 'lime',   badge: 'Учиться', statusOk: true, status: '10 сценариев' },
  { href: '/ru/recovery/',  title: 'Спасение аккаунта',    description: 'Пошаговый мастер экстренного восстановления взломанного игрового аккаунта.',      icon: 'rescue',  color: 'red',    badge: 'SOS',  statusOk: true, status: '24/7', isSos: true },
];

const featureColorMap: Record<string, { border: string; bg: string; text: string; glow: string }> = {
  cyan:   { border: 'border-cyan/25',      bg: 'bg-cyan/10',      text: 'text-cyan',      glow: 'rgba(34,211,238,0.15)' },
  violet: { border: 'border-violet/25',    bg: 'bg-violet/10',    text: 'text-violet',    glow: 'rgba(167,139,250,0.15)' },
  accent: { border: 'border-ds-accent/25', bg: 'bg-ds-accent/10', text: 'text-ds-accent', glow: 'rgba(108,140,255,0.15)' },
  orange: { border: 'border-orange/25',    bg: 'bg-orange/10',    text: 'text-orange',    glow: 'rgba(255,173,102,0.15)' },
  lime:   { border: 'border-lime/25',      bg: 'bg-lime/10',      text: 'text-lime',      glow: 'rgba(199,243,107,0.15)' },
  red:    { border: 'border-red-500/25',   bg: 'bg-red-500/10',   text: 'text-red-400',   glow: 'rgba(239,68,68,0.15)' },
};
---

<BaseLayout
  title={`${t('site.title')} — Ваша игра под защитой`}
  description={t('hero.subtitle')}
  currentLang={currentLang}
>
  <!-- Animated background -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full opacity-25 dark:opacity-15"
         style="background: radial-gradient(ellipse, rgba(108,140,255,0.3) 0%, transparent 70%); filter: blur(80px);"></div>
    <div class="absolute top-1/3 right-0 w-[600px] h-[400px] rounded-full opacity-15"
         style="background: radial-gradient(ellipse, rgba(167,139,250,0.25) 0%, transparent 70%); filter: blur(60px);"></div>
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.06]"
         style="background-image: linear-gradient(rgba(108,140,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(108,140,255,1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    <div class="absolute inset-x-0 h-px animate-scanline opacity-15"
         style="background: linear-gradient(90deg, transparent, rgba(72,214,232,0.5), transparent);"></div>
  </div>

  <div class="relative z-10">
    <!-- Hero -->
    <section class="relative px-4 sm:px-6 lg:px-8 pt-8 pb-6">
      <div class="max-w-7xl mx-auto">
        <div class="relative overflow-hidden rounded-3xl border border-ds-border bg-gradient-to-br from-ds-surface to-ds-surface2 shadow-premium p-6 sm:p-8 lg:p-10 mb-8 reveal">
          <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-0 right-0 w-[500px] h-[400px] opacity-30"
                 style="background: radial-gradient(ellipse at right top, rgba(108,140,255,0.25) 0%, transparent 70%);"></div>
            <div class="absolute right-8 top-1/2 -translate-y-1/2 opacity-10 animate-float-slow hidden lg:block">
              <svg width="180" height="200" viewBox="0 0 200 220" fill="none">
                <path d="M100 10 L180 50 V110 C180 165 146 190 100 210 C54 190 20 165 20 110 V50 Z" stroke="url(#shieldRU)" stroke-width="2" fill="none"/>
                <path d="M78 108 L94 124 L128 90" stroke="#48D6E8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="shieldRU" x1="20" y1="10" x2="180" y2="210" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#6C8CFF"/><stop offset="100%" stop-color="#48D6E8"/>
                  </linearGradient>
                </defs>
              </svg>
            </div>
          </div>

          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-ds-cyber/30 bg-ds-cyber/10 text-ds-cyber text-xs font-bold mb-5 tracking-wide uppercase">
                <span class="w-2 h-2 rounded-full bg-ds-cyber animate-pulse"></span>
                <span>Независимая платформа кибербезопасности</span>
              </div>

              <h1 class="font-heading font-extrabold text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.08] mb-4 text-ds-text">
                Ваш игровой мир.<br />
                <span class="gradient-text-cyber">Под защитой.</span>
              </h1>

              <p class="text-base sm:text-lg text-ds-text2 leading-relaxed mb-7 max-w-xl">
                Оставайтесь впереди мошенников, защитите аккаунты и играйте уверенно.
                Реальные инструменты. Настоящее образование.
              </p>

              <div class="flex flex-col sm:flex-row gap-3 mb-8">
                <a href="/ru/scanner/" class="btn-primary text-sm">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                  Проверить ссылку
                </a>
                <a href="/ru/detective/" class="btn-secondary text-sm">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                  </svg>
                  ИИ-детектив
                </a>
                <a href="/ru/recovery/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-red-500/30 bg-red-500/10 text-red-400 font-semibold text-sm hover:bg-red-500/20 transition-all">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
                  SOS Помощь
                </a>
              </div>

              <div class="flex flex-wrap gap-4 sm:gap-6">
                <div class="flex flex-col"><span class="font-heading font-extrabold text-xl text-ds-text">5+</span><span class="text-xs text-ds-text2">Игровых центров</span></div>
                <div class="flex flex-col"><span class="font-heading font-extrabold text-xl text-ds-text">10</span><span class="text-xs text-ds-text2">Сценариев мошенств</span></div>
                <div class="flex flex-col"><span class="font-heading font-extrabold text-xl text-ds-text">12</span><span class="text-xs text-ds-text2">Критериев защиты</span></div>
                <div class="flex flex-col"><span class="font-heading font-extrabold text-xl text-ds-text">{String(allThreats.length)}</span><span class="text-xs text-ds-text2">Статей об угрозах</span></div>
              </div>
            </div>

            <div class="lg:col-span-5 flex flex-col gap-3">
              <div class="rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-4">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-8 h-8 rounded-lg bg-emerald-500/20 flex items-center justify-center">
                    <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs font-bold text-emerald-400 uppercase tracking-wide">Статус платформы</div>
                    <div class="text-sm font-semibold text-ds-text">Все системы работают</div>
                  </div>
                  <div class="ml-auto flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-xs text-emerald-400 font-semibold">Живой</span>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                  <div class="rounded-xl bg-ds-surface/50 px-3 py-2">
                    <div class="text-[10px] text-ds-text2 mb-0.5">Сканер ссылок</div>
                    <div class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span class="text-xs font-semibold text-ds-text">Online</span></div>
                  </div>
                  <div class="rounded-xl bg-ds-surface/50 px-3 py-2">
                    <div class="text-[10px] text-ds-text2 mb-0.5">ИИ-детектив</div>
                    <div class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span class="text-xs font-semibold text-ds-text">Активен</span></div>
                  </div>
                  <div class="rounded-xl bg-ds-surface/50 px-3 py-2">
                    <div class="text-[10px] text-ds-text2 mb-0.5">Радар угроз</div>
                    <div class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span class="text-xs font-semibold text-ds-text">Мониторинг</span></div>
                  </div>
                  <div class="rounded-xl bg-ds-surface/50 px-3 py-2">
                    <div class="text-[10px] text-ds-text2 mb-0.5">Академия</div>
                    <div class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span class="text-xs font-semibold text-ds-text">Открыта</span></div>
                  </div>
                </div>
              </div>

              <div class="rounded-2xl border border-ds-border bg-ds-surface/50 p-4">
                <div class="text-xs font-bold text-ds-text2 uppercase tracking-wide mb-2">Быстрая проверка ссылки</div>
                <div class="flex gap-2">
                  <input type="text" placeholder="Вставьте подозрительный URL..." id="hero-quick-scan-ru" class="flex-1 premium-input py-2.5 text-sm" aria-label="Проверка ссылки"/>
                  <a href="/ru/scanner/" id="hero-scan-btn-ru" class="flex-shrink-0 px-4 py-2.5 rounded-xl bg-ds-cyber/20 border border-ds-cyber/30 text-ds-cyber font-semibold text-sm hover:bg-ds-cyber/30 transition-all">Scan</a>
                </div>
                <p class="text-[10px] text-ds-text2/60 mt-2">Полный анализ на странице сканера</p>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mb-8 reveal reveal-delay-1">
          {games.slice(0, 5).map(game => (
            <a href={`/ru/games/${game.slug}/`} class="flex items-center gap-2 px-4 py-2 rounded-xl bg-ds-surface border border-ds-border text-ds-text2 text-sm font-medium hover:border-ds-accent/40 hover:text-ds-text hover:bg-ds-surface2 transition-all">
              <span class="w-2 h-2 rounded-full flex-shrink-0" style={`background: ${game.colorTheme.accent};`}></span>
              {game.title.split(' ')[0]}
            </a>
          ))}
          <a href="/ru/games/" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-ds-surface border border-ds-border text-ds-text2 text-sm font-medium hover:border-ds-accent/40 hover:text-ds-accent transition-all">
            Все игры <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Телеметрия и Аналитика -->
    <section class="px-4 sm:px-6 lg:px-8 pb-4">
      <div class="max-w-7xl mx-auto">
        <DashboardTelemetry currentLang={currentLang} />
      </div>
    </section>

    <!-- Интерактивная Карта Кибератак -->
    <section class="px-4 sm:px-6 lg:px-8 pb-4">
      <div class="max-w-7xl mx-auto">
        <CyberAttackMap currentLang={currentLang} />
      </div>
    </section>

    <!-- Feature Cards -->
    <section class="px-4 sm:px-6 lg:px-8 pb-8">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-5 reveal">
          <div>
            <h2 class="font-heading font-bold text-xl text-ds-text">Инструменты безопасности</h2>
            <p class="text-sm text-ds-text2">Ваш полный набор защиты</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          {featureCards.map((card, i) => {
            const c = featureColorMap[card.color] || featureColorMap.accent;
            return (
              <div class={`tilt-card-container reveal reveal-delay-${Math.min(i+1, 5)}`}>
                <a href={card.href} class={`tilt-card group block rounded-2xl border ${card.isSos ? 'border-red-500/20' : 'border-ds-border hover:border-ds-accent/30'} bg-ds-surface hover:bg-ds-surface2 p-5 transition-all duration-300 hover:shadow-premium-hover relative overflow-hidden`}>
                  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-2xl"
                       style={`background: radial-gradient(ellipse at 30% 30%, ${c.glow}, transparent 70%);`}></div>
                  <div class="relative z-10">
                    <div class="flex items-start justify-between mb-4">
                      <div class={`w-11 h-11 rounded-xl ${c.bg} ${c.border} border flex items-center justify-center flex-shrink-0`}>
                        {card.icon === 'scanner' && <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>}
                        {card.icon === 'ai' && <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>}
                        {card.icon === 'score' && <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>}
                        {card.icon === 'radar' && <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728M9 12a3 3 0 106 0 3 3 0 00-6 0M12 8v4"/></svg>}
                        {card.icon === 'sim' && <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>}
                        {card.icon === 'rescue' && <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>}
                      </div>
                      <div class="flex flex-col items-end gap-1.5">
                        <span class={`text-[10px] font-bold px-2 py-0.5 rounded-md ${c.bg} ${c.text} ${c.border} border uppercase tracking-wide ${card.isSos ? 'animate-pulse' : ''}`}>{card.badge}</span>
                        <div class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span class="text-[10px] text-ds-text2">{card.status}</span></div>
                      </div>
                    </div>
                    <h3 class="font-heading font-bold text-base text-ds-text mb-1.5 group-hover:text-ds-cyber transition-colors">{card.title}</h3>
                    <p class="text-xs text-ds-text2 leading-relaxed mb-4">{card.description}</p>
                    <div class="flex items-center gap-1.5 text-xs font-semibold text-ds-text2 group-hover:text-ds-accent transition-colors">
                      <span>Открыть</span>
                      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </div>
                  </div>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Game Centers -->
    <section class="px-4 sm:px-6 lg:px-8 pb-8">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-5 reveal">
          <div><h2 class="font-heading font-bold text-xl text-ds-text">Игровые центры безопасности</h2><p class="text-sm text-ds-text2">Специализированные руководства по играм</p></div>
          <a href="/ru/games/" class="text-ds-accent text-sm font-semibold hover:text-ds-cyber transition-colors flex items-center gap-1">Все игры <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
          {games.map((game, i) => (
            <div class={`reveal reveal-delay-${Math.min(i+1, 5)} tilt-card-container`}>
              <a href={`/ru/games/${game.slug}/`} class="tilt-card group block rounded-2xl border border-ds-border bg-ds-surface hover:border-ds-accent/30 overflow-hidden transition-all duration-300 hover:shadow-premium-hover">
                <div class="relative h-28 overflow-hidden flex items-center justify-center" style={`background: linear-gradient(135deg, ${game.colorTheme.bgGlow}, rgba(17,25,54,0.8));`}>
                  <div class="text-4xl opacity-30 group-hover:opacity-50 transition-opacity font-heading font-black text-ds-text select-none">{game.title.substring(0, 2).toUpperCase()}</div>
                  <div class="absolute top-2 right-2"><span class="text-[9px] font-bold px-2 py-0.5 rounded-md border uppercase tracking-wide" style={`background: ${game.colorTheme.bgGlow}; color: ${game.colorTheme.accent}; border-color: ${game.colorTheme.accent}40;`}>{game.riskBadge.split(' ')[0]}</span></div>
                  <div class="absolute bottom-0 inset-x-0 h-0.5" style={`background: linear-gradient(90deg, transparent, ${game.colorTheme.accent}, transparent);`}></div>
                </div>
                <div class="p-4">
                  <h3 class="font-heading font-bold text-sm text-ds-text mb-1 line-clamp-1 group-hover:text-ds-cyber transition-colors">{game.title}</h3>
                  <p class="text-[11px] text-ds-text2 leading-snug line-clamp-2 mb-3">{game.cardDescription.substring(0, 80)}...</p>
                  <div class="flex items-center justify-between">
                    <div class="flex gap-1">{game.commonRiskTags.slice(0, 1).map(tag => (<span class="text-[9px] px-1.5 py-0.5 rounded-md bg-ds-surface2 text-ds-text2 border border-ds-border">{tag.split(' ')[0]}</span>))}</div>
                    <svg class="w-3.5 h-3.5 text-ds-text2 group-hover:text-ds-accent group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Шаблоны мошенничества -->
    <div class="px-4 sm:px-6 lg:px-8 pb-12">
      <div class="max-w-7xl mx-auto">
        <ScamPatterns currentLang={currentLang} />
      </div>
    </div>

    <!-- Интерактивный квиз -->
    <div id="scam-quiz" class="px-4 sm:px-6 lg:px-8 pb-12">
      <div class="max-w-7xl mx-auto">
        <ScamQuiz currentLang={currentLang} />
      </div>
    </div>

    <!-- Emergency CTA -->
    <section class="px-4 sm:px-6 lg:px-8 pb-12">
      <div class="max-w-7xl mx-auto">
        <div class="reveal rounded-3xl border border-red-500/20 bg-gradient-to-r from-red-950/40 via-ds-surface to-ds-surface2 p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6">
          <div class="w-12 h-12 rounded-2xl bg-red-500/20 border border-red-500/30 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <div class="flex-1 text-center sm:text-left">
            <h2 class="font-heading font-bold text-lg text-ds-text mb-1">Аккаунт взломан? Действуйте немедленно.</h2>
            <p class="text-sm text-ds-text2">Не паникуйте. Наш мастер восстановления поможет вам шаг за шагом.</p>
          </div>
          <a href="/ru/recovery/" class="flex-shrink-0 flex items-center gap-2 px-6 py-3 rounded-xl bg-red-500/20 border border-red-500/30 text-red-400 font-bold text-sm hover:bg-red-500/30 transition-all">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
            Открыть мастер
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const scanInput = document.getElementById('hero-quick-scan-ru') as HTMLInputElement;
  const scanBtn   = document.getElementById('hero-scan-btn-ru');
  scanBtn?.addEventListener('click', (e) => {
    const val = scanInput?.value?.trim();
    if (val) { e.preventDefault(); window.location.href = `/ru/scanner/?url=${encodeURIComponent(val)}`; }
  });
  scanInput?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') {
      const val = (e.target as HTMLInputElement).value.trim();
      if (val) window.location.href = `/ru/scanner/?url=${encodeURIComponent(val)}`;
    }
  });
</script>
