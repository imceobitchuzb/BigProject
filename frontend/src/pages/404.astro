---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout
  title="404 — Page Not Found | SafeInGame"
  description="The requested page could not be found on SafeInGame."
  currentLang="en"
>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <div class="w-20 h-20 mx-auto mb-6">
      <Logo size="lg" showText={false} />
    </div>
    <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold border border-orange-500/40 bg-orange-500/10 text-orange-600 dark:text-orange mb-4">
      Error 404
    </span>
    <h1 class="text-4xl font-heading font-extrabold text-slate-900 dark:text-cloud mb-4">
      Page Not Found / Страница не найдена
    </h1>
    <p class="text-sm text-slate-600 dark:text-cloud-muted leading-relaxed mb-8 max-w-md mx-auto">
      The link you followed may be broken or the security guide has been updated. Please choose your preferred language:
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/en/"
        class="w-full sm:w-auto px-6 py-3 rounded-xl bg-cyan-dark dark:bg-cyan text-white dark:text-navy-950 font-heading font-bold text-sm hover:bg-cyan transition-all shadow-glow-cyan"
      >
        Go to English Homepage
      </a>
      <a
        href="/ru/"
        class="w-full sm:w-auto px-6 py-3 rounded-xl border border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-850 hover:bg-slate-50 dark:hover:bg-navy-800 text-slate-900 dark:text-cloud font-heading font-bold text-sm transition-all shadow-sm"
      >
        Перейти на главную (RU)
      </a>
    </div>
  </div>
</BaseLayout>
