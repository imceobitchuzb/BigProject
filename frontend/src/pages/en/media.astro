---
import Layout from '../../layouts/Layout.astro';
import SafiMascot from '../../components/SafiMascot.astro';

const newsItems = [
  {
    date: 'November 2026',
    tag: 'SECURITY ADVISORY',
    tagColor: 'bg-red-500/10 text-red-400 border-red-500/30',
    title: 'Surge in Steam Web API Key MitM Scams Targeting CS2 Traders',
    summary: 'Phishing networks are exploiting forged tournament voting portals to register unauthorized API keys, silently rerouting trades to bot clones.',
  },
  {
    date: 'October 2026',
    tag: 'COMMUNITY UPDATE',
    tagColor: 'bg-cyan-500/10 text-cyan border-cyan-500/30',
    title: 'SafeInGame Launches 2.5D Scam Simulator & Academy Tracks',
    summary: 'Gamers can now practice neutralizing 10 authentic attack scenarios and earn verified educational cyber defense badges without risking real items.',
  },
  {
    date: 'October 2026',
    tag: 'RESEARCH BULLETIN',
    tagColor: 'bg-purple-500/10 text-purple-400 border-purple-500/30',
    title: 'Analysis of .ROBLOSECURITY Session Theft via DevTools Scripts',
    summary: 'Detailed forensic investigation of social engineering schemes convincing young players to paste malicious code into browser consoles for fake items.',
  },
];
---

<Layout
  title="Media & Content Center — SafeInGame"
  description="Official threat advisories, cybersecurity research bulletins, and SafeInGame project news."
  currentLang="en"
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <!-- Header Card -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-navy-900 to-slate-950 border border-cyan/20 p-6 sm:p-10 mb-12 shadow-2xl">
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-4 text-center md:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan text-xs font-semibold">
            <span>Newsroom & Research</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
            Media & News Center
          </h1>
          <p class="text-slate-400 text-sm sm:text-base max-w-xl leading-relaxed">
            Stay updated with the latest gaming threat intelligence, security advisories, and technical reports published by SafeInGame research.
          </p>
        </div>

        <div class="shrink-0 flex flex-col items-center">
          <SafiMascot mood="guard" size="xl" />
          <span class="text-xs font-bold text-cyan mt-3">Press & Research</span>
        </div>
      </div>
    </div>

    <!-- News List -->
    <div class="space-y-6 mb-12">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Recent Bulletins & Advisories</h2>
      <div class="grid grid-cols-1 gap-4">
        {newsItems.map((item) => (
          <div class="rounded-3xl bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 p-6 sm:p-8 hover:border-cyan/40 transition">
            <div class="flex items-center gap-3 mb-3">
              <span class={`text-[10px] font-black uppercase px-2.5 py-0.5 rounded border ${item.tagColor}`}>
                {item.tag}
              </span>
              <span class="text-xs text-slate-400">{item.date}</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{item.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-cloud-muted leading-relaxed">{item.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
