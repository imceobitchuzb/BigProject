---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScamPatterns from '../../components/ScamPatterns.astro';
import ScamQuiz from '../../components/ScamQuiz.astro';
import DashboardTelemetry from '../../components/DashboardTelemetry.astro';
import CyberAttackMap from '../../components/CyberAttackMap.astro';
import { getAllGames } from '../../data/games';
import { getCollection } from 'astro:content';

const currentLang = 'en';

// Games list
const games = getAllGames(currentLang);

// Get threat articles for English
const allThreats = await getCollection('threats', ({ id }) => id.startsWith('en/'));
const sortedThreats = allThreats.sort(
  (a, b) => new Date(b.data.published_date).getTime() - new Date(a.data.published_date).getTime()
);
const featuredThreats = sortedThreats.slice(0, 3);

// Dashboard feature cards
const featureCards = [
  {
    href: '/en/scanner/',
    title: 'Link Security Scanner',
    description: 'Detect homoglyphs, typosquatting, and phishing URLs targeting gamers in real time.',
    icon: 'scanner',
    color: 'cyan',
    badge: 'Live Tool',
    status: 'Online',
    statusOk: true,
  },
  {
    href: '/en/detective/',
    title: 'AI Scam Detective',
    description: 'Analyze suspicious messages, trade offers, and screenshots for social engineering vectors.',
    icon: 'ai',
    color: 'violet',
    badge: 'AI',
    status: 'Active',
    statusOk: true,
  },
  {
    href: '/en/score/',
    title: 'Security Score',
    description: 'Evaluate your gaming defense posture across 12 security vectors. 100% private.',
    icon: 'score',
    color: 'accent',
    badge: 'Check',
    status: 'Ready',
    statusOk: true,
  },
  {
    href: '/en/radar/',
    title: 'Threat Radar',
    description: 'Live global tracker of active gaming scam campaigns and phishing waves.',
    icon: 'radar',
    color: 'orange',
    badge: 'Intel',
    status: 'Monitoring',
    statusOk: true,
  },
  {
    href: '/en/simulator/',
    title: 'Scam Simulator',
    description: '10 realistic interactive scam scenarios to train your instincts safely.',
    icon: 'sim',
    color: 'lime',
    badge: 'Train',
    status: '10 Scenarios',
    statusOk: true,
  },
  {
    href: '/en/recovery/',
    title: 'Account Rescue',
    description: 'Step-by-step emergency wizard when your gaming account has been compromised.',
    icon: 'rescue',
    color: 'red',
    badge: 'SOS',
    status: '24/7',
    statusOk: true,
    isSos: true,
  },
];

const stats = [
  { label: 'Games Protected', value: '5', suffix: '+', icon: 'game' },
  { label: 'Scam Scenarios', value: '10', suffix: '', icon: 'shield' },
  { label: 'Security Checks', value: '12', suffix: '', icon: 'check' },
  { label: 'Threat Articles', value: String(allThreats.length), suffix: '', icon: 'article' },
];

const featureColorMap: Record<string, { border: string; bg: string; text: string; glow: string }> = {
  cyan:   { border: 'border-cyan/25',       bg: 'bg-cyan/10',       text: 'text-cyan',      glow: 'rgba(34,211,238,0.15)' },
  violet: { border: 'border-violet/25',     bg: 'bg-violet/10',     text: 'text-violet',    glow: 'rgba(167,139,250,0.15)' },
  accent: { border: 'border-ds-accent/25',  bg: 'bg-ds-accent/10',  text: 'text-ds-accent', glow: 'rgba(108,140,255,0.15)' },
  orange: { border: 'border-orange/25',     bg: 'bg-orange/10',     text: 'text-orange',    glow: 'rgba(255,173,102,0.15)' },
  lime:   { border: 'border-lime/25',       bg: 'bg-lime/10',       text: 'text-lime',      glow: 'rgba(199,243,107,0.15)' },
  red:    { border: 'border-red-500/25',    bg: 'bg-red-500/10',    text: 'text-red-400',   glow: 'rgba(239,68,68,0.15)' },
};
---

<BaseLayout
  title="SafeInGame — Premium Gaming Cybersecurity Platform"
  description="Stay ahead of scams, protect your accounts, and play with confidence. The leading gaming cybersecurity education platform."
  currentLang={currentLang}
>
  <!-- ═══════════════════════════════════════════════════
       ANIMATED BACKGROUND
       ═══════════════════════════════════════════════════ -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
    <!-- Deep ambient glow -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full opacity-30 dark:opacity-20"
         style="background: radial-gradient(ellipse, rgba(108,140,255,0.3) 0%, transparent 70%); filter: blur(80px);"></div>
    <div class="absolute top-1/3 right-0 w-[600px] h-[400px] rounded-full opacity-20 dark:opacity-15"
         style="background: radial-gradient(ellipse, rgba(167,139,250,0.25) 0%, transparent 70%); filter: blur(60px);"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[400px] rounded-full opacity-15 dark:opacity-10"
         style="background: radial-gradient(ellipse, rgba(72,214,232,0.2) 0%, transparent 70%); filter: blur(60px);"></div>

    <!-- Subtle grid -->
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.06]"
         style="background-image: linear-gradient(rgba(108,140,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(108,140,255,1) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <!-- Floating particles -->
    <div class="absolute w-1 h-1 rounded-full bg-ds-cyber/60 animate-particle-drift" style="left: 15%; animation-delay: 0s; animation-duration: 18s;"></div>
    <div class="absolute w-1.5 h-1.5 rounded-full bg-ds-accent/50 animate-particle-drift" style="left: 35%; animation-delay: 3s; animation-duration: 22s;"></div>
    <div class="absolute w-1 h-1 rounded-full bg-ds-accent2/60 animate-particle-drift" style="left: 65%; animation-delay: 7s; animation-duration: 19s;"></div>
    <div class="absolute w-0.5 h-0.5 rounded-full bg-ds-cyber/40 animate-particle-drift" style="left: 80%; animation-delay: 12s; animation-duration: 25s;"></div>

    <!-- Slow scanline -->
    <div class="absolute inset-x-0 h-px animate-scanline opacity-20"
         style="background: linear-gradient(90deg, transparent, rgba(72,214,232,0.5), transparent);"></div>
  </div>

  <div class="relative z-10">

    <!-- ═══════════════════════════════════════════════════
         HERO SECTION
         ═══════════════════════════════════════════════════ -->
    <section class="relative px-4 sm:px-6 lg:px-8 pt-8 pb-6">
      <div class="max-w-7xl mx-auto">

        <!-- Hero Card — Premium glass design -->
        <div class="relative overflow-hidden rounded-3xl border border-ds-border bg-gradient-to-br from-ds-surface to-ds-surface2 shadow-premium p-6 sm:p-8 lg:p-10 mb-8 reveal">

          <!-- Hero background decoration -->
          <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-0 right-0 w-[500px] h-[400px] opacity-30"
                 style="background: radial-gradient(ellipse at right top, rgba(108,140,255,0.25) 0%, transparent 70%);"></div>
            <!-- Floating geometric shield -->
            <div class="absolute right-8 top-1/2 -translate-y-1/2 opacity-10 dark:opacity-15 animate-float-slow hidden lg:block">
              <svg width="200" height="220" viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M100 10 L180 50 V110 C180 165 146 190 100 210 C54 190 20 165 20 110 V50 Z"
                      stroke="url(#heroShieldGrad)" stroke-width="2" fill="none"/>
                <path d="M100 30 L165 63 V115 C165 158 137 180 100 196 C63 180 35 158 35 115 V63 Z"
                      stroke="url(#heroShieldGrad)" stroke-width="1.5" fill="none" opacity="0.5"/>
                <path d="M78 108 L94 124 L128 90" stroke="#48D6E8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="heroShieldGrad" x1="20" y1="10" x2="180" y2="210" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#6C8CFF"/>
                    <stop offset="100%" stop-color="#48D6E8"/>
                  </linearGradient>
                </defs>
              </svg>
            </div>
            <!-- Orbiting rings -->
            <div class="absolute right-16 top-1/2 -translate-y-1/2 hidden xl:block opacity-5">
              <div class="w-[300px] h-[300px] rounded-full border border-ds-cyber animate-spin-slow"></div>
            </div>
          </div>

          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Hero copy -->
            <div class="lg:col-span-7">
              <!-- Status badge -->
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-ds-cyber/30 bg-ds-cyber/10 text-ds-cyber text-xs font-bold mb-5 tracking-wide uppercase">
                <span class="w-2 h-2 rounded-full bg-ds-cyber animate-pulse"></span>
                <span>Independent Gaming Cybersecurity Platform</span>
              </div>

              <h1 class="font-heading font-extrabold text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.08] mb-4 text-ds-text dark:text-ds-text">
                Your Gaming World.<br />
                <span class="gradient-text-cyber">Protected.</span>
              </h1>

              <p class="text-base sm:text-lg text-ds-text2 leading-relaxed mb-7 max-w-xl">
                Stay ahead of scams, protect your accounts, and play with confidence.
                Real tools. Real education. No fake security theater.
              </p>

              <!-- CTA buttons -->
              <div class="flex flex-col sm:flex-row gap-3 mb-8">
                <a href="/en/scanner/" class="btn-primary text-sm shadow-glow-cyber hover:shadow-glow-cyber transition-all">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                  Scan a Suspicious Link
                </a>
                <a href="/en/detective/" class="btn-secondary text-sm">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                  </svg>
                  AI Scam Detective
                </a>
                <a href="/en/recovery/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-red-500/30 bg-red-500/10 text-red-400 font-semibold text-sm hover:bg-red-500/20 transition-all">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
                  SOS Rescue
                </a>
              </div>

              <!-- Quick stat row -->
              <div class="flex flex-wrap gap-4 sm:gap-6">
                {stats.map(s => (
                  <div class="flex flex-col">
                    <span class="font-heading font-extrabold text-xl text-ds-text" data-counter data-target={s.value.replace('+','')}>
                      {s.value}{s.suffix}
                    </span>
                    <span class="text-xs text-ds-text2">{s.label}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Hero visual panel -->
            <div class="lg:col-span-5 flex flex-col gap-3">
              <!-- Security status mini panel -->
              <div class="rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-4">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-8 h-8 rounded-lg bg-emerald-500/20 flex items-center justify-center">
                    <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs font-bold text-emerald-400 uppercase tracking-wide">Platform Status</div>
                    <div class="text-sm font-semibold text-ds-text">All Systems Operational</div>
                  </div>
                  <div class="ml-auto flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-xs text-emerald-400 font-semibold">Live</span>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                  <div class="rounded-xl bg-ds-surface/50 px-3 py-2">
                    <div class="text-[10px] text-ds-text2 mb-0.5">Link Scanner</div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <span class="text-xs font-semibold text-ds-text">Online</span>
                    </div>
                  </div>
                  <div class="rounded-xl bg-ds-surface/50 px-3 py-2">
                    <div class="text-[10px] text-ds-text2 mb-0.5">AI Detective</div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <span class="text-xs font-semibold text-ds-text">Active</span>
                    </div>
                  </div>
                  <div class="rounded-xl bg-ds-surface/50 px-3 py-2">
                    <div class="text-[10px] text-ds-text2 mb-0.5">Threat Radar</div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <span class="text-xs font-semibold text-ds-text">Monitoring</span>
                    </div>
                  </div>
                  <div class="rounded-xl bg-ds-surface/50 px-3 py-2">
                    <div class="text-[10px] text-ds-text2 mb-0.5">Academy</div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <span class="text-xs font-semibold text-ds-text">Open</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Quick scan box -->
              <div class="rounded-2xl border border-ds-border bg-ds-surface/50 p-4">
                <div class="text-xs font-bold text-ds-text2 uppercase tracking-wide mb-2">Quick Link Check</div>
                <div class="flex gap-2">
                  <input
                    type="text"
                    placeholder="Paste a suspicious URL..."
                    id="hero-quick-scan"
                    class="flex-1 premium-input py-2.5 text-sm"
                    aria-label="Quick URL scan"
                  />
                  <a
                    href="/en/scanner/"
                    id="hero-scan-btn"
                    class="flex-shrink-0 px-4 py-2.5 rounded-xl bg-ds-cyber/20 border border-ds-cyber/30 text-ds-cyber font-semibold text-sm hover:bg-ds-cyber/30 transition-all"
                  >
                    Scan
                  </a>
                </div>
                <p class="text-[10px] text-ds-text2/60 mt-2">Full analysis available on the Scanner page</p>
              </div>
            </div>
          </div>
        </div>

        <!-- ─── Game selector pills ─── -->
        <div class="flex flex-wrap gap-2 mb-8 reveal reveal-delay-1">
          {games.slice(0, 5).map(game => (
            <a
              href={`/en/games/${game.slug}/`}
              class="flex items-center gap-2 px-4 py-2 rounded-xl bg-ds-surface border border-ds-border text-ds-text2 text-sm font-medium hover:border-ds-accent/40 hover:text-ds-text hover:bg-ds-surface2 transition-all group"
            >
              <span class="w-2 h-2 rounded-full flex-shrink-0"
                    style={"background: " + game.colorTheme.accent + ";"}></span>
              {game.title.split(' ')[0]}
            </a>
          ))}
          <a
            href="/en/games/"
            class="flex items-center gap-2 px-4 py-2 rounded-xl bg-ds-surface border border-ds-border text-ds-text2 text-sm font-medium hover:border-ds-accent/40 hover:text-ds-accent transition-all"
          >
            All Games
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         TELEMETRY & ACTIVITY STATS (Reference Image "Statistic" & Right Column)
         ═══════════════════════════════════════════════════ -->
    <section class="px-4 sm:px-6 lg:px-8 pb-4">
      <div class="max-w-7xl mx-auto">
        <DashboardTelemetry currentLang={currentLang} />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         GLOBAL GAMER CYBER ATTACK MAP
         ═══════════════════════════════════════════════════ -->
    <section class="px-4 sm:px-6 lg:px-8 pb-4">
      <div class="max-w-7xl mx-auto">
        <CyberAttackMap currentLang={currentLang} />
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         DASHBOARD FEATURE CARDS
         ═══════════════════════════════════════════════════ -->
    <section class="px-4 sm:px-6 lg:px-8 pb-8">
      <div class="max-w-7xl mx-auto">

        <div class="flex items-center justify-between mb-5 reveal">
          <div>
            <h2 class="font-heading font-bold text-xl text-ds-text">Security Tools</h2>
            <p class="text-sm text-ds-text2">Your complete protection toolkit</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          {featureCards.map((card, i) => {
            const c = featureColorMap[card.color] || featureColorMap.accent;
            return (
              <div class={`tilt-card-container reveal reveal-delay-${Math.min(i+1, 5)}`}>
                <a
                  href={card.href}
                  class={`tilt-card group block rounded-2xl border ${card.isSos ? 'border-red-500/20 animate-border-pulse' : 'border-ds-border hover:border-ds-accent/30'} bg-ds-surface hover:bg-ds-surface2 p-5 transition-all duration-300 hover:shadow-premium-hover relative overflow-hidden`}
                >
                  <!-- Card glow on hover -->
                  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-2xl"
                       style={"background: radial-gradient(ellipse at 30% 30%, " + c.glow + ", transparent 70%);"}></div>

                  <div class="relative z-10">
                    <!-- Card header -->
                    <div class="flex items-start justify-between mb-4">
                      <div class={`w-11 h-11 rounded-xl ${c.bg} ${c.border} border flex items-center justify-center flex-shrink-0`}>
                        {card.icon === 'scanner' && (
                          <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                          </svg>
                        )}
                        {card.icon === 'ai' && (
                          <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                          </svg>
                        )}
                        {card.icon === 'score' && (
                          <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                          </svg>
                        )}
                        {card.icon === 'radar' && (
                          <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728M9 12a3 3 0 106 0 3 3 0 00-6 0M12 8v4"/>
                          </svg>
                        )}
                        {card.icon === 'sim' && (
                          <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                          </svg>
                        )}
                        {card.icon === 'rescue' && (
                          <svg class={`w-5 h-5 ${c.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                          </svg>
                        )}
                      </div>

                      <div class="flex flex-col items-end gap-1.5">
                        <span class={`text-[10px] font-bold px-2 py-0.5 rounded-md ${c.bg} ${c.text} ${c.border} border uppercase tracking-wide ${card.isSos ? 'animate-pulse' : ''}`}>
                          {card.badge}
                        </span>
                        <div class="flex items-center gap-1">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                          <span class="text-[10px] text-ds-text2">{card.status}</span>
                        </div>
                      </div>
                    </div>

                    <h3 class="font-heading font-bold text-base text-ds-text mb-1.5 group-hover:text-ds-cyber transition-colors">
                      {card.title}
                    </h3>
                    <p class="text-xs text-ds-text2 leading-relaxed mb-4">
                      {card.description}
                    </p>

                    <!-- Card footer arrow -->
                    <div class="flex items-center gap-1.5 text-xs font-semibold text-ds-text2 group-hover:text-ds-accent transition-colors">
                      <span>Open Tool</span>
                      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </div>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         GAME CENTERS — "Watch Now" style
         ═══════════════════════════════════════════════════ -->
    <section class="px-4 sm:px-6 lg:px-8 pb-8">
      <div class="max-w-7xl mx-auto">

        <div class="flex items-center justify-between mb-5 reveal">
          <div>
            <h2 class="font-heading font-bold text-xl text-ds-text">Game Security Centers</h2>
            <p class="text-sm text-ds-text2">Game-specific threat intel and protection guides</p>
          </div>
          <a href="/en/games/" class="text-ds-accent text-sm font-semibold hover:text-ds-cyber transition-colors flex items-center gap-1">
            View All
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
          {games.map((game, i) => {
            return (
              <div class={`reveal reveal-delay-${Math.min(i+1, 5)} tilt-card-container`}>
                <a
                  href={`/en/games/${game.slug}/`}
                  class="tilt-card group block rounded-2xl border border-ds-border bg-ds-surface hover:border-ds-accent/30 overflow-hidden transition-all duration-300 hover:shadow-premium-hover"
                >
                  <!-- Game card gradient header -->
                  <div class="relative h-28 overflow-hidden flex items-center justify-center"
                       style={`background: linear-gradient(135deg, ${game.colorTheme.bgGlow}, rgba(17,25,54,0.8));`}>
                    <!-- Game logo placeholder — elegant SVG -->
                    <div class="text-4xl opacity-30 group-hover:opacity-50 transition-opacity font-heading font-black text-ds-text select-none">
                      {game.title.substring(0, 2).toUpperCase()}
                    </div>
                    <!-- Risk badge -->
                    <div class="absolute top-2 right-2">
                      <span class="text-[9px] font-bold px-2 py-0.5 rounded-md border uppercase tracking-wide"
                            style={`background: ${game.colorTheme.bgGlow}; color: ${game.colorTheme.accent}; border-color: ${game.colorTheme.accent}40;`}>
                        {game.riskBadge.split(' ')[0]}
                      </span>
                    </div>
                    <!-- Color accent bar -->
                    <div class="absolute bottom-0 inset-x-0 h-0.5"
                         style={`background: linear-gradient(90deg, transparent, ${game.colorTheme.accent}, transparent);`}></div>
                  </div>

                  <div class="p-4">
                    <h3 class="font-heading font-bold text-sm text-ds-text mb-1 line-clamp-1 group-hover:text-ds-cyber transition-colors">
                      {game.title}
                    </h3>
                    <p class="text-[11px] text-ds-text2 leading-snug line-clamp-2 mb-3">
                      {game.cardDescription.substring(0, 80)}...
