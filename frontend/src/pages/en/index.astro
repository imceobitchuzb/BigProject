                      </div>
                      <svg class="w-3.5 h-3.5 text-ds-text2 group-hover:text-ds-accent group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </div>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         LATEST THREAT INTELLIGENCE
         ═══════════════════════════════════════════════════ -->
    {featuredThreats.length > 0 && (
      <section class="px-4 sm:px-6 lg:px-8 pb-8">
        <div class="max-w-7xl mx-auto">

          <div class="flex items-center justify-between mb-5 reveal">
            <div>
              <h2 class="font-heading font-bold text-xl text-ds-text">Latest Security Alerts</h2>
              <p class="text-sm text-ds-text2">Verified gaming threat intelligence</p>
            </div>
            <a href="/en/threats/" class="text-ds-accent text-sm font-semibold hover:text-ds-cyber transition-colors flex items-center gap-1">
              View All
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {featuredThreats.map((threat, i) => (
              <div class={`reveal reveal-delay-${i+1}`}>
                <a
                  href={`/en/threats/${threat.slug.replace('en/', '')}/`}
                  class="group block rounded-2xl border border-ds-border bg-ds-surface hover:bg-ds-surface2 hover:border-ds-accent/30 p-5 transition-all duration-300 hover:shadow-premium-hover h-full"
                >
                  <div class="flex items-center gap-2 mb-3">
                    <span class="status-badge status-warning text-xs">
                      <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span>
                      Alert
                    </span>
                    <span class="text-[10px] text-ds-text2">{new Date(threat.data.published_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                  </div>
                  <h3 class="font-heading font-bold text-sm text-ds-text mb-2 group-hover:text-ds-cyber transition-colors line-clamp-2">
                    {threat.data.title}
                  </h3>
                  <p class="text-xs text-ds-text2 leading-relaxed line-clamp-3 mb-3">
                    {threat.data.description || threat.data.summary || ''}
                  </p>
                  <div class="flex items-center gap-1.5 text-xs font-semibold text-ds-text2 group-hover:text-ds-accent transition-colors mt-auto">
                    <span>Read Guide</span>
                    <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ═══════════════════════════════════════════════════
         UNIVERSAL SCAM PATTERNS
         ═══════════════════════════════════════════════════ -->
    <div class="px-4 sm:px-6 lg:px-8 pb-12">
      <div class="max-w-7xl mx-auto">
        <ScamPatterns currentLang={currentLang} />
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════
         SCAM AWARENESS QUIZ
         ═══════════════════════════════════════════════════ -->
    <div id="scam-quiz" class="px-4 sm:px-6 lg:px-8 pb-12">
      <div class="max-w-7xl mx-auto">
        <ScamQuiz currentLang={currentLang} />
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════
         EMERGENCY CTA BANNER
         ═══════════════════════════════════════════════════ -->
    <section class="px-4 sm:px-6 lg:px-8 pb-10">
      <div class="max-w-7xl mx-auto">
        <div class="reveal rounded-3xl border border-red-500/20 bg-gradient-to-r from-red-950/40 via-ds-surface to-ds-surface2 p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6 relative overflow-hidden">
          <!-- Pulse decoration -->
          <div class="absolute right-8 top-1/2 -translate-y-1/2 w-32 h-32 rounded-full bg-red-500/5 animate-pulse-subtle pointer-events-none hidden lg:block"></div>

          <div class="w-12 h-12 rounded-2xl bg-red-500/20 border border-red-500/30 flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>

          <div class="flex-1 text-center sm:text-left">
            <h2 class="font-heading font-bold text-lg text-ds-text mb-1">Account Compromised? Act Immediately.</h2>
            <p class="text-sm text-ds-text2">
              Don't panic. Our step-by-step Account Rescue Wizard guides you through emergency account recovery for any gaming platform.
            </p>
          </div>

          <a
            href="/en/recovery/"
            class="flex-shrink-0 flex items-center gap-2 px-6 py-3 rounded-xl bg-red-500/20 border border-red-500/30 text-red-400 font-bold text-sm hover:bg-red-500/30 hover:border-red-500/50 transition-all"
          >
            <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
            Open Account Rescue
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         CORE PRINCIPLES (Mission)
         ═══════════════════════════════════════════════════ -->
    <section class="px-4 sm:px-6 lg:px-8 pb-12">
      <div class="max-w-7xl mx-auto">

        <div class="text-center mb-8 reveal">
          <h2 class="font-heading font-bold text-2xl text-ds-text mb-2">Our Core Principles</h2>
          <p class="text-sm text-ds-text2">Transparent, independent digital protection for the global gaming community.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {[
            {
              icon: 'edu',
              color: 'cyan',
              title: 'Educational Empowerment',
              text: 'We explain how threats work under the hood. No fake scareware, no unrealistic guarantees.',
            },
            {
              icon: 'privacy',
              color: 'violet',
              title: 'Absolute Privacy Respect',
              text: 'We never ask for gaming passwords, 2FA codes, session tokens, or personal identifiers.',
            },
            {
              icon: 'intel',
              color: 'lime',
              title: 'Verified Threat Intelligence',
              text: 'All recommendations are validated against official platform protocols and cybersecurity research.',
            },
          ].map((p, i) => (
            <div class={`reveal reveal-delay-${i+1} rounded-2xl border border-ds-border bg-ds-surface p-6`}>
              <div class={`w-11 h-11 rounded-xl mb-4 flex items-center justify-center ${
                p.color === 'cyan' ? 'bg-cyan/10 text-cyan' :
                p.color === 'violet' ? 'bg-violet/10 text-violet' :
                'bg-lime/10 text-lime'
              }`}>
                {p.icon === 'edu' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                  </svg>
                )}
                {p.icon === 'privacy' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                )}
                {p.icon === 'intel' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                  </svg>
                )}
              </div>
              <h3 class="font-heading font-bold text-base text-ds-text mb-2">{p.title}</h3>
              <p class="text-xs text-ds-text2 leading-relaxed">{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  // Quick hero scan redirect
  const scanInput = document.getElementById('hero-quick-scan') as HTMLInputElement;
  const scanBtn   = document.getElementById('hero-scan-btn');

  scanBtn?.addEventListener('click', (e) => {
    const val = scanInput?.value?.trim();
    if (val) {
      e.preventDefault();
      window.location.href = `/en/scanner/?url=${encodeURIComponent(val)}`;
    }
  });

  scanInput?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') {
      const val = (e.target as HTMLInputElement).value.trim();
      if (val) window.location.href = `/en/scanner/?url=${encodeURIComponent(val)}`;
    }
  });
</script>
