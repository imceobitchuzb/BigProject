                    <div class="flex items-center justify-between">
                      <div class="flex gap-1 flex-wrap">
                        {game.commonRiskTags.slice(0, 1).map(tag => (
                          <span class="text-[9px] px-1.5 py-0.5 rounded-md bg-ds-surface2 text-ds-text2 border border-ds-border">
                            {tag.split(' ')[0]}
