# SafeInGame Environment Configuration Template
# Copy this file to .env and fill in real values for your environment.

# Service configuration
PROJECT_NAME="SafeInGame API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database connection string
# Local development: SQLite
DATABASE_URL="sqlite:///./safeingame.db"
# Production growth path (PostgreSQL):
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/safeingame"

# Allowed CORS origins (JSON array format)
CORS_ORIGINS=["http://localhost:4321","http://127.0.0.1:4321","https://safeingame.org"]

# Rate limiting for public endpoints (requests/window)
RATE_LIMIT_CONTACT="5/minute"

# Secret key for founder inspection / administrative actions
ADMIN_API_KEY="replace-with-a-secure-random-token-in-production"
